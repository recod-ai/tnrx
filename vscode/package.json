{
  "name": "tnrx",
  "displayName": "tnrx",
  "description": "Montagens do tnrx-connect, configuração do projeto (tnrx.conf), cluster e Jupyter dos projetos no servidor, na barra lateral.",
  "version": "0.2.1",
  "publisher": "tnrx",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "scripts": {
    "test": "node --test test/",
    "package": "python3 build-vsix.py"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tnrx",
          "title": "tnrx",
          "icon": "media/tnrx.svg"
        }
      ]
    },
    "views": {
      "tnrx": [
        {
          "id": "tnrx.mounts",
          "name": "Montagens"
        },
        {
          "id": "tnrx.slurm",
          "name": "Configuração do projeto"
        },
        {
          "id": "tnrx.cluster",
          "name": "Cluster"
        },
        {
          "id": "tnrx.jupyter",
          "name": "Jupyter"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tnrx.mounts",
        "contents": "Nenhuma pasta do tnrx-connect neste computador.\n[Montar uma pasta](command:tnrx.mountNew)\nO login (senha/2FA) é feito no terminal que abre."
      }
    ],
    "commands": [
      {
        "command": "tnrx.refresh",
        "title": "Atualizar",
        "category": "tnrx",
        "icon": "$(refresh)"
      },
      {
        "command": "tnrx.mountNew",
        "title": "Montar uma pasta…",
        "category": "tnrx",
        "icon": "$(add)"
      },
      {
        "command": "tnrx.mount",
        "title": "Montar (abre o terminal)",
        "category": "tnrx",
        "icon": "$(play)"
      },
      {
        "command": "tnrx.reconnect",
        "title": "Reconectar (login no terminal)",
        "category": "tnrx",
        "icon": "$(key)"
      },
      {
        "command": "tnrx.ssh",
        "title": "Abrir terminal do servidor",
        "category": "tnrx",
        "icon": "$(terminal)"
      },
      {
        "command": "tnrx.unmount",
        "title": "Desmontar",
        "category": "tnrx",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "tnrx.openFolder",
        "title": "Abrir pasta em nova janela",
        "category": "tnrx",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tnrx.openLog",
        "title": "Ver log da montagem",
        "category": "tnrx",
        "icon": "$(output)"
      },
      {
        "command": "tnrx.openSlurm",
        "title": "Abrir tnrx.conf",
        "category": "tnrx",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tnrx.reconnectHost",
        "title": "Reconectar (login no terminal)",
        "category": "tnrx",
        "icon": "$(key)"
      },
      {
        "command": "tnrx.jupyterTerminal",
        "title": "Jupyter no terminal (listar, iniciar, conectar)",
        "category": "tnrx",
        "icon": "$(terminal)"
      },
      {
        "command": "tnrx.copyJupyterUrl",
        "title": "Copiar URL do Jupyter",
        "category": "tnrx",
        "icon": "$(copy)"
      },
      {
        "command": "tnrx.editConfigKey",
        "title": "Mudar valor…",
        "category": "tnrx",
        "icon": "$(edit)"
      },
      {
        "command": "tnrx.resetConfigKey",
        "title": "Voltar ao padrão",
        "category": "tnrx",
        "icon": "$(discard)"
      },
      {
        "command": "tnrx.renameMount",
        "title": "Renomear…",
        "category": "tnrx",
        "icon": "$(edit)"
      },
      {
        "command": "tnrx.forgetMount",
        "title": "Apagar montagem…",
        "category": "tnrx",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tnrx.mount",
          "when": "false"
        },
        {
          "command": "tnrx.reconnect",
          "when": "false"
        },
        {
          "command": "tnrx.ssh",
          "when": "false"
        },
        {
          "command": "tnrx.unmount",
          "when": "false"
        },
        {
          "command": "tnrx.openFolder",
          "when": "false"
        },
        {
          "command": "tnrx.openLog",
          "when": "false"
        },
        {
          "command": "tnrx.openSlurm",
          "when": "false"
        },
        {
          "command": "tnrx.reconnectHost",
          "when": "false"
        },
        {
          "command": "tnrx.jupyterTerminal",
          "when": "false"
        },
        {
          "command": "tnrx.copyJupyterUrl",
          "when": "false"
        },
        {
          "command": "tnrx.editConfigKey",
          "when": "false"
        },
        {
          "command": "tnrx.resetConfigKey",
          "when": "false"
        },
        {
          "command": "tnrx.renameMount",
          "when": "false"
        },
        {
          "command": "tnrx.forgetMount",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tnrx.mountNew",
          "when": "view == tnrx.mounts",
          "group": "navigation@1"
        },
        {
          "command": "tnrx.refresh",
          "when": "view =~ /^tnrx\\./",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "tnrx.ssh",
          "when": "view == tnrx.mounts && viewItem == mount-ok",
          "group": "inline@1"
        },
        {
          "command": "tnrx.reconnect",
          "when": "view == tnrx.mounts && viewItem == mount-disconnected",
          "group": "inline@1"
        },
        {
          "command": "tnrx.mount",
          "when": "view == tnrx.mounts && viewItem =~ /^mount-(stale|unmounted)$/",
          "group": "inline@1"
        },
        {
          "command": "tnrx.unmount",
          "when": "view == tnrx.mounts && viewItem =~ /^mount-(ok|disconnected|stale)$/",
          "group": "inline@2"
        },
        {
          "command": "tnrx.openFolder",
          "when": "view == tnrx.mounts && viewItem =~ /^mount-(ok|disconnected)$/",
          "group": "1_open@1"
        },
        {
          "command": "tnrx.openLog",
          "when": "view == tnrx.mounts && viewItem =~ /^mount-/",
          "group": "1_open@2"
        },
        {
          "command": "tnrx.openSlurm",
          "when": "view == tnrx.slurm && viewItem == slurm-mount",
          "group": "inline@1"
        },
        {
          "command": "tnrx.reconnectHost",
          "when": "view == tnrx.cluster && viewItem == cluster-host-disconnected",
          "group": "inline@1"
        },
        {
          "command": "tnrx.jupyterTerminal",
          "when": "view == tnrx.jupyter && viewItem == jupyter-project",
          "group": "inline@1"
        },
        {
          "command": "tnrx.copyJupyterUrl",
          "when": "view == tnrx.jupyter && viewItem == jupyter-server-bridged",
          "group": "inline@1"
        },
        {
          "command": "tnrx.editConfigKey",
          "when": "view == tnrx.slurm && viewItem =~ /^slurm-key-/",
          "group": "inline@1"
        },
        {
          "command": "tnrx.resetConfigKey",
          "when": "view == tnrx.slurm && viewItem == slurm-key-file",
          "group": "inline@2"
        },
        {
          "command": "tnrx.renameMount",
          "when": "view == tnrx.mounts && viewItem =~ /^mount-/",
          "group": "2_manage@1"
        },
        {
          "command": "tnrx.forgetMount",
          "when": "view == tnrx.mounts && viewItem == mount-unmounted",
          "group": "2_manage@2"
        }
      ]
    },
    "configuration": {
      "title": "tnrx",
      "properties": {
        "tnrx.connectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Caminho do `tnrx-connect`. Vazio: procura no `PATH` e em `~/.local/bin`."
        },
        "tnrx.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "markdownDescription": "Segundos entre atualizações de **Montagens** e **Jupyter** (o Jupyter só é consultado com o bloco visível). Montar/desmontar aparece na hora, sem esperar."
        },
        "tnrx.clusterRefreshInterval": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "Segundos entre consultas ao **Cluster** (`sinfo`, com o bloco visível). `0` = só no botão Atualizar. O `sinfo` roda no headnode compartilhado: evite valores baixos."
        }
      }
    }
  }
}
