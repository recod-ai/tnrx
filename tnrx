#!/bin/bash

# --- Configurações Fixas ---
CONFIG_FILE="tnrx_slurm.conf"

# --- Defaults ---
DEFAULT_PARTITION="l40s"
DEFAULT_GPUS="1"
DEFAULT_CPUS="2"
DEFAULT_MEM="4G"
DEFAULT_TIME="00:10:00"

# --- Alteração 1: Defaults da Imagem Singularity ---
DEFAULT_SIF_NAME="pytorch_devel.sif"
DEFAULT_DOCKER_SOURCE="docker://nvcr.io/nvidia/pytorch:24.01-py3"

# --- Helpers ---

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    fi
    PARTITION=${PARTITION:-$DEFAULT_PARTITION}
    GPUS=${GPUS:-$DEFAULT_GPUS}
    CPUS=${CPUS:-$DEFAULT_CPUS}
    MEM=${MEM:-$DEFAULT_MEM}
    TIME=${TIME:-$DEFAULT_TIME}
}

find_sif() {
    local sifs=( *.sif )
    if [ ! -e "${sifs[0]}" ]; then
        echo "❌ Erro: Nenhum arquivo .sif encontrado. Use 'tnrx install singularity'." >&2
        exit 1
    elif [ ${#sifs[@]} -gt 1 ]; then
        echo "❌ Erro: Mais de um .sif encontrado. Mantenha apenas um no diretório." >&2
        exit 1
    fi
    echo "${sifs[0]}"
}

load_env_vars() {
    # Carrega variáveis de ambiente do arquivo .tnrx_env e prepara flags para singularity
    SINGULARITY_ENV_FLAGS=""
    if [ -f ".tnrx_env" ]; then
        # Lê o arquivo e processa cada linha
        mapfile -t env_lines < ".tnrx_env"
        for line in "${env_lines[@]}"; do
            # Ignora linhas vazias e comentários
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            # Separa chave e valor
            IFS='=' read -r key value <<< "$line"
            # Remove espaços em branco nas extremidades
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs)
            # Constrói flags para passar ao singularity exec
            SINGULARITY_ENV_FLAGS="$SINGULARITY_ENV_FLAGS --env $key=$value"
        done
    fi
}

# --- Comandos Principais ---

do_install() {
    case $1 in
        uv)
            echo "📦 Instalando UV em ~/.local/bin..."
            curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR="$HOME/.local/bin" sh
            echo "✅ uv instalado."
            ;;

        singularity)
            # Alteração 1: Uso de parâmetros com fallback para defaults
            local sif_name="${2:-$DEFAULT_SIF_NAME}"
            local docker_url="${3:-$DEFAULT_DOCKER_SOURCE}"

            if [ -f "$sif_name" ]; then
                echo "ℹ️  A imagem $sif_name já existe localmente."
                read -p "Deseja baixar novamente? (y/N) " resp
                [[ "$resp" != "y" ]] && return
            fi

            echo "📥 Baixando imagem: $docker_url"
            echo "💾 Destino: $sif_name"
            singularity pull "$sif_name" "$docker_url"
            echo "✅ Instalação concluída."
            ;;

        *)
            echo "Uso: ./tnrx install {uv|singularity}"
            ;;
    esac
}


do_uv() {
    local cmd=$1
    case $cmd in
        add|remove|sync|init|lock|tree|export)
            load_env_vars
            local image=$(find_sif) || exit 1
            echo "🌐 [HEADNODE] Gestão de pacotes: uv $cmd"
            singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ "$image" $HOME/.local/bin/uv "$@"
            ;;
        run|python|pip)
            echo "⚠️  Erro: Comandos de execução devem usar 'tnrx uvslurm'."
            exit 1
            ;;
        *)
            echo "Uso: tnrx uv {add|remove|sync|init|...}"
            ;;
    esac
}

do_slurm() {
    load_env_vars
    load_config
    local image=$(find_sif) || exit 1

    # Se não houver argumentos ou se o primeiro for 'bash', abre modo interativo
    if [ $# -eq 0 ] || [ "$1" == "bash" ]; then
        echo "🖥️  Sessão INTERATIVA no nó [$PARTITION]..."
        srun --partition="$PARTITION" --gres=gpu:"$GPUS" --cpus-per-task="$CPUS" \
             --mem="$MEM" --time="$TIME" --pty \
             singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" /bin/bash
    else
        echo "⚙️  Slurm: $PARTITION | GPU:$GPUS | Executando: $*"
        srun --partition="$PARTITION" --gres=gpu:"$GPUS" --cpus-per-task="$CPUS" \
             --mem="$MEM" --time="$TIME" \
             singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" "$@"
    fi
}


do_uvslurm() {
    load_env_vars
    load_config
    local image=$(find_sif) || exit 1
    local UV_BIN="$HOME/.local/bin/uv"

    if [ $# -eq 0 ]; then
        echo "❌ Erro: Nenhum comando/script fornecido para o UV+Slurm." >&2
        exit 1
    fi

    local EXTRA_FLAGS=""
    # Se o comando contiver "jupyter", fazemos a configuração especial
    if [[ "$*" == *"jupyter"* ]]; then
        echo "🔧 [Jupyter Detectado] Configurando Kernel e Rede..."

        # 1. Registra o kernel para garantir que o Notebook veja o .venv
        # Usamos o nome da pasta atual para o kernel ser único por projeto
        echo local project_name=$(basename "$PWD")
        local project_name=$(basename "$PWD")
        echo singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" \
            "$UV_BIN" run python -m ipykernel install --user \
            --name="tnrx-$project_name" --display-name="Python (TNRX-$project_name)" > /dev/null 2>&1
        singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" \
            "$UV_BIN" run python -m ipykernel install --user \
            --name="tnrx-$project_name" --display-name="Python (TNRX-$project_name)" > /dev/null 2>&1

        # 2. Adiciona as flags de IP e Origem para evitar o erro 403 Forbidden
        EXTRA_FLAGS="--ip=0.0.0.0 --no-browser"
    fi

    echo "🚀 [SLURM+UV] $PARTITION | GPU:$GPUS | Executando: uv run $* $EXTRA_FLAGS"

    # Execução única do srun
    echo srun --partition="$PARTITION" \
         --gres=gpu:"$GPUS" \
         --cpus-per-task="$CPUS" \
         --mem="$MEM" \
         --time="$TIME" \
         singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" \
         "$UV_BIN" run --frozen "$@" $EXTRA_FLAGS
    srun --partition="$PARTITION" \
         --gres=gpu:"$GPUS" \
         --cpus-per-task="$CPUS" \
         --mem="$MEM" \
         --time="$TIME" \
         singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ --nv "$image" \
         "$UV_BIN" run --frozen "$@" $EXTRA_FLAGS
}


# ... (outras funções do tnrx)

do_huggingface() {
    load_env_vars
    local type=$1   # model ou dataset
    local repo=$2   # author/repo

    # 1. Validação de Argumentos
    if [[ -z "$type" || -z "$repo" ]]; then
        echo "❌ Uso: tnrx huggingface {model|dataset} author/repo"
        exit 1
    fi

    # 2. Verificação de existência do Token
    if [[ -z "$HF_TOKEN" ]]; then
        echo "❌ Erro: Variável de ambiente HF_TOKEN não encontrada."
        echo "Adicione ao seu ~/.bashrc: export HF_TOKEN='seu_token_aqui'"
        echo "Ou adicione ao arquivo $CONFIG_FILE"
        exit 1
    fi

    # 3. Teste rápido de validade do Token (API whoami)
    echo "🔍 Validando HF_TOKEN..."
    local check_token
    check_token=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $HF_TOKEN" https://huggingface.co/api/whoami-v2)

    if [ "$check_token" != "200" ]; then
        echo "❌ Erro: HF_TOKEN inválido ou expirado (HTTP $check_token)."
        exit 1
    fi
    echo "✅ Token validado com sucesso."

    local image=$(find_sif) || exit 1

    # Nota: Removi o 'uv sync' para tornar o download mais direto,
    # partindo do princípio que o usuário já preparou o ambiente.

    echo "🌐 [HEADNODE] Iniciando download do Hugging Face..."
    # Usamos singularityENV_ para garantir que a env chegue intacta ao container
    export singularityENV_HF_TOKEN="$HF_TOKEN"

    echo singularity exec --bind /data/:/data/ \
                   "$image" \
                   $HOME/.local/bin/uv run $HOME/.local/bin/download_huggingface "$type" "$repo"
    singularity exec $SINGULARITY_ENV_FLAGS --bind /data/:/data/ \
                   "$image" \
                   $HOME/.local/bin/uv run $HOME/.local/bin/download_huggingface "$type" "$repo"
}

do_uninstall() {
    echo "🗑️  Removendo links simbólicos do ambiente local..."

    # Lista de links criados em ~/.local/bin/
    local links=("tnrx" "download_huggingface")
    local bin_dir="$HOME/.local/bin"
    local found=false

    for link in "${links[@]}"; do
        if [ -L "$bin_dir/$link" ]; then
            rm "$bin_dir/$link"
            echo "✅ Removido: $bin_dir/$link"
            found=true
        fi
    done

    if ! $found; then
        echo "phi  Nenhum link simbólico do tnrx foi encontrado em $bin_dir."
    else
        echo "✨ Desinstalação concluída. Os arquivos originais permanecem intactos."
    fi
}

# --- Lógica de Entrada ---

do_uninstall() {
    echo "🗑️  Removendo links simbólicos do ambiente local..."

    # Lista de links criados em ~/.local/bin/
    local links=("tnrx" "download_huggingface")
    local bin_dir="$HOME/.local/bin"
    local found=false

    for link in "${links[@]}"; do
        if [ -L "$bin_dir/$link" ]; then
            rm "$bin_dir/$link"
            echo "✅ Removido: $bin_dir/$link"
            found=true
        fi
    done

    if ! $found; then
        echo "phi  Nenhum link simbólico do tnrx foi encontrado em $bin_dir."
    else
        echo "✨ Desinstalação concluída. Os arquivos originais permanecem intactos."
    fi
}

# --- Lógica de Entrada ---

case $1 in
    install) shift; do_install "$@" ;;
    uv)      shift; do_uv "$@" ;;
    slurm)   shift; do_slurm "$@" ;;
    uvslurm) shift; do_uvslurm "$@" ;;
    huggingface|hf) shift; do_huggingface "$@" ;;
    uninstall) shift; do_uninstall ;;
    *)
        echo "Uso: tnrx {install|uninstall|uv|slurm|uvslurm|hf}"
        echo "  tnrx install singularity      -> Cria o .sif"
        echo "  tnrx uv add <pkg>           -> Gerencia dependências no Headnode"
        echo "  tnrx slurm <cmd>            -> Roda comando genérico no Slurm"
        echo "  tnrx uvslurm <script>       -> Roda script Python via UV no Slurm"
        echo "  tnrx hf model author/repo -> Baixa modelo do Hugging Face"
        ;;
esac
