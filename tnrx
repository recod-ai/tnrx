#!/bin/bash

# --- Configurações Fixas ---
CONFIG_FILE="tnrx_slurm.conf"

# Diretório onde o script `tnrx` de verdade mora (resolve symlinks), usado
# para achar tnrx_hosts.conf independentemente da pasta do projeto atual.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
HOSTS_FILE="$SCRIPT_DIR/tnrx_hosts.conf"

# --- Defaults ---
DEFAULT_PARTITION="l40s"
DEFAULT_GPUS="1"
DEFAULT_CPUS="2"
DEFAULT_MEM="4G"
DEFAULT_TIME="00:10:00"

# Imagem usada quando o projeto não tem um tnrx.def próprio.
DEFAULT_DOCKER_SOURCE="docker://nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04"
# Banco de imagens do usuário: cada .sif é gerado uma vez aqui, e os projetos
# só guardam um link simbólico para ele.
SIF_DIR="${TNRX_SIF_DIR:-$HOME/.tnrx/sifs}"
# Definition file do projeto; se existir, o .sif é gerado a partir dele.
PROJECT_DEF="tnrx.def"
# Modelo de definition file que acompanha o tnrx, para copiar para o projeto.
TEMPLATE_DEF="$SCRIPT_DIR/tnrx.def"

UV_BIN="$HOME/.local/bin/uv"

# --- Flag global de debug ---
DEBUG=0

# --- Particularidades do servidor atual (preenchidas por load_host_config) ---
HOST_BIND_PATH=""
HOST_RUNTIME=""
HOST_HUB_ROOT=""
RUNTIME_ENV_PREFIX=""

# --- Helpers ---

run_cmd() {
    # Executa o comando recebido, imprimindo-o antes se DEBUG estiver ativo.
    if [ "$DEBUG" -eq 1 ]; then
        local part
        printf '🔎 [DEBUG] Comando real: '
        for part in "$@"; do
            printf '%q ' "$part"
        done
        printf '\n'
    fi
    "$@"
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    fi
    PARTITION=${PARTITION:-$DEFAULT_PARTITION}
    GPUS=${GPUS:-$DEFAULT_GPUS}
    CPUS=${CPUS:-$DEFAULT_CPUS}
    MEM=${MEM:-$DEFAULT_MEM}
    TIME=${TIME:-$DEFAULT_TIME}
}

load_host_config() {
    # Lê tnrx_hosts.conf e preenche HOST_BIND_PATH/HOST_RUNTIME/HOST_HUB_ROOT
    # e RUNTIME_ENV_PREFIX (ex.: SINGULARITYENV_) para o hostname atual.
    local hostname=$(hostname)

    if [ ! -f "$HOSTS_FILE" ]; then
        echo "❌ Erro: Arquivo de configuração de servidores não encontrado: $HOSTS_FILE" >&2
        exit 1
    fi

    local host bind runtime hub_root
    while IFS='|' read -r host bind runtime hub_root; do
        [[ -z "$host" || "$host" =~ ^[[:space:]]*# ]] && continue
        if [ "$host" == "$hostname" ]; then
            HOST_BIND_PATH="$bind"
            HOST_RUNTIME="${runtime:-singularity}"
            HOST_HUB_ROOT="$hub_root"
            RUNTIME_ENV_PREFIX="$(echo "$HOST_RUNTIME" | tr '[:lower:]' '[:upper:]')ENV_"
            if ! command -v "$HOST_RUNTIME" >/dev/null 2>&1; then
                echo "❌ Erro: '$HOST_RUNTIME' não foi encontrado nesta máquina (hostname '$hostname')." >&2
                echo "   O tnrx precisa rodar num nó que tenha o $HOST_RUNTIME (e o Slurm). Você está no servidor certo?" >&2
                exit 1
            fi
            return 0
        fi
    done < "$HOSTS_FILE"

    local known_hosts
    known_hosts=$(grep -vE '^[[:space:]]*(#|$)' "$HOSTS_FILE" | cut -d'|' -f1 | tr '\n' ' ')
    echo "⚠️  AVISO: Hostname '$hostname' não está configurado em $HOSTS_FILE." >&2
    echo "⚠️  Hosts configurados: $known_hosts" >&2
    echo "❌ Execução abortada por segurança." >&2
    exit 1
}

get_bind_path() {
    echo "$HOST_BIND_PATH"
}

check_hostname() {
    load_host_config
}

# --- Banco de imagens (.sif) ---

sif_name_for_source() {
    # Nome da imagem no banco, derivado da origem, para o nome dizer de onde ela veio:
    #   docker://nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 -> nvidia_cuda_12.6.3-cudnn-runtime-ubuntu24.04.sif
    #   tnrx.def (From: nvidia/cuda:...)                      -> nvidia_cuda_...__def-<8 hex do conteúdo>.sif
    # O hash faz projetos com o mesmo .def compartilharem a imagem, e um .def
    # editado gerar uma imagem nova.
    local src="$1" base hash
    if [[ "$src" == *.def ]]; then
        base=$(awk 'tolower($1) == "from:" { print $2; exit }' "$src")
        hash=$(sha256sum "$src" | cut -c1-8)
        base="${base:-def}"
        base="${base#*://}"; base="${base//\//_}"; base="${base//:/_}"; base="${base//@/_}"
        echo "${base}__def-${hash}.sif"
    else
        base="${src#*://}"; base="${base//\//_}"; base="${base//:/_}"; base="${base//@/_}"
        echo "${base}.sif"
    fi
}

ensure_image() {
    # Garante a imagem da origem $1 no banco (pull ou build), e a regenera com $2=force.
    # Deixa o nome em IMAGE_NAME. Gera num arquivo temporário e só depois renomeia,
    # para um download interrompido nunca deixar uma imagem pela metade no banco.
    local src="$1" force="$2" target tmp
    IMAGE_NAME=$(sif_name_for_source "$src")
    target="$SIF_DIR/$IMAGE_NAME"
    if [ -f "$target" ] && [ "$force" != "force" ]; then
        echo "ℹ️  Imagem já está no banco: $target"
        return 0
    fi
    mkdir -p "$SIF_DIR"
    tmp="$SIF_DIR/.tmp-$$-$IMAGE_NAME"
    if [[ "$src" == *.def ]]; then
        # Sem root, o build depende do --fakeroot (o admin precisa ter
        # configurado /etc/subuid e /etc/subgid para o usuário).
        local fakeroot=()
        [ "$(id -u)" -ne 0 ] && fakeroot=(--fakeroot)
        echo "🔨 Gerando imagem a partir de: $src"
        echo "💾 Destino: $target"
        if ! run_cmd "$HOST_RUNTIME" build "${fakeroot[@]}" "$tmp" "$src"; then
            rm -f "$tmp"
            echo "❌ Erro: O build falhou." >&2
            echo "   Se a mensagem fala de fakeroot/subuid, este servidor não permite build sem root:" >&2
            echo "   gere a imagem em outra máquina ($HOST_RUNTIME build $IMAGE_NAME $src)" >&2
            echo "   e copie para $target." >&2
            exit 1
        fi
    else
        echo "📥 Baixando imagem: $src"
        echo "💾 Destino: $target"
        if ! run_cmd "$HOST_RUNTIME" pull "$tmp" "$src"; then
            rm -f "$tmp"
            echo "❌ Erro: O download da imagem falhou." >&2
            exit 1
        fi
    fi
    mv -f "$tmp" "$target"
}

link_image() {
    # Põe na pasta atual um link para a imagem $1 do banco, no lugar dos links
    # antigos. Um .sif que é arquivo de verdade só sai com confirmação.
    local name="$1" f resp
    for f in *.sif; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        [ "$f" == "$name" ] && [ -L "$f" ] && continue
        if [ -L "$f" ]; then
            rm -f "$f"
        else
            echo "ℹ️  Esta pasta tem uma imagem própria: $f ($(du -h "$f" | cut -f1))."
            read -p "Apagar e usar o link para o banco? (y/N) " resp
            if [[ "$resp" != "y" ]]; then
                echo "❌ Mantida. Só pode haver um .sif na pasta, então o link não foi criado." >&2
                exit 1
            fi
            rm -f "$f"
        fi
    done
    ln -sfn "$SIF_DIR/$name" "$name"
    echo "🔗 $name -> $SIF_DIR/$name"
}

is_interactive() {
    # TNRX_INTERACTIVE=1 força o modo interativo (usado pelos testes).
    [ "$TNRX_INTERACTIVE" == "1" ] || { [ -t 0 ] && [ -t 2 ]; }
}

choose_image() {
    # Pasta sem .sif: oferece as imagens do banco (o tnrx.def do projeto e a
    # padrão primeiro, gerando-as se faltarem) e cria o link para a escolhida.
    local -a names=() sources=() labels=()
    local name f i choice
    if [ -f "$PROJECT_DEF" ]; then
        name=$(sif_name_for_source "$PROJECT_DEF")
        names+=("$name"); sources+=("$PROJECT_DEF")
        labels+=("$name  (do $PROJECT_DEF deste projeto$([ -f "$SIF_DIR/$name" ] || echo '; será gerada'))")
    fi
    name=$(sif_name_for_source "$DEFAULT_DOCKER_SOURCE")
    names+=("$name"); sources+=("$DEFAULT_DOCKER_SOURCE")
    labels+=("$name  (padrão$([ -f "$SIF_DIR/$name" ] || echo '; será baixada'))")
    for f in "$SIF_DIR"/*.sif; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        [[ " ${names[*]} " == *" $name "* ]] && continue
        names+=("$name"); sources+=(""); labels+=("$name")
    done

    echo "⚠️  Nenhuma imagem (.sif) nesta pasta. Imagens disponíveis ($SIF_DIR):" >&2
    for i in "${!labels[@]}"; do
        echo "  [$((i + 1))] ${labels[$i]}" >&2
    done
    read -p "Criar link para qual? [1] (n = cancelar): " choice
    choice="${choice:-1}"
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#names[@]}" ]; then
        echo "❌ Cancelado. Para criar depois: tnrx install singularity" >&2
        exit 1
    fi
    i=$((choice - 1))
    [ -n "${sources[$i]}" ] && ensure_image "${sources[$i]}" >&2
    link_image "${names[$i]}" >&2
}

find_sif() {
    # Deixa em SIF a imagem da pasta atual. Sem nenhuma, pergunta (num terminal)
    # qual imagem do banco usar.
    local f
    local -a sifs=() broken=()
    for f in *.sif; do
        if [ -e "$f" ]; then
            sifs+=("$f")
        elif [ -L "$f" ]; then
            broken+=("$f")
        fi
    done
    for f in "${broken[@]}"; do
        echo "⚠️  O link $f aponta para uma imagem que não existe mais ($(readlink "$f"))." >&2
    done
    if [ ${#sifs[@]} -gt 1 ]; then
        echo "❌ Erro: Mais de um .sif encontrado. Mantenha apenas um no diretório." >&2
        exit 1
    elif [ ${#sifs[@]} -eq 0 ]; then
        if ! is_interactive; then
            echo "❌ Erro: Nenhum arquivo .sif encontrado. Use 'tnrx install singularity'." >&2
            exit 1
        fi
        choose_image
        sifs=(*.sif)
    fi
    SIF="${sifs[0]}"
}

load_env_vars() {
    # Carrega variáveis de ambiente do arquivo .tnrx_env e as exporta com o
    # prefixo do runtime do host (ex.: SINGULARITYENV_) para que ele as
    # injete no container.
    ENV_VAR_KEYS=()
    if [ -f ".tnrx_env" ]; then
        # Lê o arquivo e processa cada linha
        mapfile -t env_lines < ".tnrx_env"
        for line in "${env_lines[@]}"; do
            # Ignora linhas vazias e comentários
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            # Ignora linhas sem "="
            [[ "$line" != *"="* ]] && continue

            local key="${line%%=*}"
            local value="${line#*=}"

            # Remove espaços em branco nas extremidades sem usar xargs
            # (xargs reinterpreta o valor como argumentos de shell, o que
            # pode corromper tokens contendo aspas, barras ou glob).
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            [[ -z "$key" ]] && continue

            export "${RUNTIME_ENV_PREFIX}${key}=${value}"
            ENV_VAR_KEYS+=("$key")
        done
    fi
}

unset_env_vars() {
    # Remove do ambiente do processo as variáveis carregadas por load_env_vars,
    # evitando que segredos permaneçam expostos além do necessário.
    local key
    for key in "${ENV_VAR_KEYS[@]}"; do
        unset "${RUNTIME_ENV_PREFIX}${key}"
    done
}

# --- Comandos Principais ---

do_install() {
    case $1 in
        uv)
            echo "📦 Instalando UV em ~/.local/bin..."
            curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR="$HOME/.local/bin" sh
            echo "✅ uv instalado."
            ;;

        singularity)
            # tnrx install singularity [arquivo.def|docker://imagem] [--force]
            # Garante a imagem no banco e põe na pasta atual um link para ela.
            # Origem: a pedida, senão o tnrx.def do projeto, senão a padrão.
            shift
            local source="" force="" arg
            for arg in "$@"; do
                case "$arg" in
                    --force) force=force ;;
                    *) source="$arg" ;;
                esac
            done
            local explicit="$source"
            if [ -z "$source" ]; then
                if [ -f "$PROJECT_DEF" ]; then
                    source="$PROJECT_DEF"
                else
                    source="$DEFAULT_DOCKER_SOURCE"
                fi
            fi
            if [[ "$source" == *.def ]] && [ ! -f "$source" ]; then
                echo "❌ Erro: Definition file não encontrado: $source" >&2
                exit 1
            fi
            load_host_config
            ensure_image "$source" "$force"
            link_image "$IMAGE_NAME"
            if [ -z "$explicit" ] && [[ "$source" != *.def ]]; then
                echo "💡 Para customizar a imagem deste projeto, copie o modelo e rode de novo:"
                echo "   cp $TEMPLATE_DEF ."
            fi
            echo "✅ Pronto."
            ;;

        "")
            # Preparação do servidor: o uv e a imagem padrão no banco. O
            # install.sh roda isto ao instalar ou atualizar num servidor.
            if [ -x "$UV_BIN" ]; then
                echo "ℹ️  uv já instalado: $UV_BIN"
            else
                do_install uv
            fi
            load_host_config
            ensure_image "$DEFAULT_DOCKER_SOURCE"
            echo "✅ Servidor pronto. Num projeto, rode qualquer comando do tnrx: ele oferece a imagem."
            ;;

        *)
            echo "Uso: tnrx install                    (instala o tnrx: links, uv e a imagem padrão)"
            echo "     tnrx install uv"
            echo "     tnrx install singularity [arquivo.def|docker://imagem] [--force]"
            ;;
    esac
}


do_uv() {
    local cmd=$1
    case $cmd in
        add|remove|sync|init|lock|tree|export)
            check_hostname
            load_env_vars
            local image
            find_sif; image="$SIF"
            local bind_path=$(get_bind_path) || exit 1
            echo "🌐 [HEADNODE] Gestão de pacotes: uv $cmd"
            run_cmd "$HOST_RUNTIME" exec --bind "$bind_path" "$image" "$UV_BIN" "$@"
            unset_env_vars
            ;;
        run|python|pip)
            echo "⚠️  Erro: Comandos de execução devem usar 'tnrx uvslurm'."
            exit 1
            ;;
        *)
            echo "Uso: tnrx uv {add|remove|sync|init|...}"
            ;;
    esac
}

do_slurm() {
    check_hostname
    load_env_vars
    load_config
    local image
    find_sif; image="$SIF"
    local bind_path=$(get_bind_path) || exit 1

    # Se não houver argumentos ou se o primeiro for 'bash', abre modo interativo
    if [ $# -eq 0 ] || [ "$1" == "bash" ]; then
        echo "🖥️  Sessão INTERATIVA no nó [$PARTITION]..."
        run_cmd srun --partition="$PARTITION" --gres=gpu:"$GPUS" --cpus-per-task="$CPUS" \
             --mem="$MEM" --time="$TIME" --pty \
             "$HOST_RUNTIME" exec --bind "$bind_path" --nv "$image" /bin/bash
    else
        echo "⚙️  Slurm: $PARTITION | GPU:$GPUS | Executando: $*"
        run_cmd srun --partition="$PARTITION" --gres=gpu:"$GPUS" --cpus-per-task="$CPUS" \
             --mem="$MEM" --time="$TIME" \
             "$HOST_RUNTIME" exec --bind "$bind_path" --nv "$image" "$@"
    fi
    unset_env_vars
}


do_uvslurm() {
    check_hostname
    load_env_vars
    load_config
    local image
    find_sif; image="$SIF"
    local bind_path=$(get_bind_path) || exit 1

    if [ $# -eq 0 ]; then
        echo "❌ Erro: Nenhum comando/script fornecido para o UV+Slurm." >&2
        exit 1
    fi

    local EXTRA_FLAGS=""
    local wrapper=()
    # Se o comando contiver "jupyter", fazemos a configuração especial
    if [[ "$*" == *"jupyter"* ]]; then
        echo "🔧 [Jupyter Detectado] Configurando Kernel e Rede..."

        # 1. Registra o kernel para garantir que o Notebook veja o .venv
        # Usamos o nome da pasta atual para o kernel ser único por projeto
        local project_name=$(basename "$PWD")
        run_cmd "$HOST_RUNTIME" exec --bind "$bind_path" --nv "$image" \
            "$UV_BIN" run python -m ipykernel install --user \
            --name="tnrx-$project_name" --display-name="Python (TNRX-$project_name)" > /dev/null 2>&1

        # 2. Adiciona as flags de IP e Origem para evitar o erro 403 Forbidden
        EXTRA_FLAGS="--ip=0.0.0.0 --no-browser"

        # 3. Algumas imagens (ex.: as NGC da NVIDIA) trazem um jupyter_notebook_config.py com
        # custom_display_url='http://hostname:8888' (literal). O nome do nó e a
        # porta livre só existem dentro do job, então o wrapper os resolve lá e
        # passa a URL certa ao Jupyter (a última flag da linha vence a config).
        # port_retries=0: a porta escolhida é a impressa, sem deslocar sozinha.
        # A senha (token) é a fixa do projeto, se o tnrx-connect a gravou em .tnrx/jupyter/token.
        # Um processo em segundo plano espera a porta responder e só então registra o
        # servidor em .tnrx/jupyter/<job>.env (600), que o `tnrx-connect jupyter` lê.
        # Sem stdout/stderr pra não segurar o srun; o .gitignore próprio evita que o token
        # vá pra um `git add .`.
        local jupyter_wrapper='port=${TNRX_JUPYTER_PORT:-8888}
            while (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; do port=$((port + 1)); done
            node=$(hostname 2>/dev/null || echo "$HOSTNAME")
            # Senha fixa do projeto, gravada pelo tnrx-connect (laptop) em .tnrx/jupyter/token;
            # sem ela (ou inválida), uma aleatória por execução.
            token=$(tr -dc "0-9a-fA-F" < "$PWD/.tnrx/jupyter/token" 2>/dev/null | head -c 64)
            [ "${#token}" -ge 32 ] || token=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d " \n")
            echo "🌐 [tnrx] Nó: $node | porta: $port  (do laptop: tnrx-connect jupyter)"
            (
                umask 077
                i=0
                while [ "$i" -lt "${TNRX_JUPYTER_REGISTER_SECS:-180}" ]; do
                    if (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
                        reg="$PWD/.tnrx/jupyter"
                        mkdir -p "$reg"
                        [ -e "$PWD/.tnrx/.gitignore" ] || printf "*\n" > "$PWD/.tnrx/.gitignore"
                        printf "NODE=%s\nPORT=%s\nTOKEN=%s\nJOBID=%s\nSTARTED=%s\nPROJECT=%s\n" \
                            "$node" "$port" "$token" "${SLURM_JOB_ID:-$$}" "$(date +%s)" "$PWD" \
                            > "$reg/${SLURM_JOB_ID:-$$}.env"
                        break
                    fi
                    i=$((i + 1)); sleep 1
                done
            ) >/dev/null 2>&1 &
            exec "$@" --port="$port" --ServerApp.port_retries=0 \
                --IdentityProvider.token="$token" \
                --ServerApp.custom_display_url="http://$node:$port"'
        wrapper=(bash -c "$jupyter_wrapper" bash)
    fi

    echo "🚀 [SLURM+UV] $PARTITION | GPU:$GPUS | Executando: uv run $* $EXTRA_FLAGS"

    run_cmd srun --partition="$PARTITION" \
         --gres=gpu:"$GPUS" \
         --cpus-per-task="$CPUS" \
         --mem="$MEM" \
         --time="$TIME" \
         "$HOST_RUNTIME" exec --bind "$bind_path" --nv "$image" \
         "${wrapper[@]}" "$UV_BIN" run --frozen "$@" $EXTRA_FLAGS
    unset_env_vars
}


# ... (outras funções do tnrx)

do_huggingface() {
    check_hostname
    load_env_vars
    local type=$1   # model ou dataset
    local repo=$2   # author/repo
    local bind_path=$(get_bind_path) || exit 1

    # 1. Validação de Argumentos
    if [[ -z "$type" || -z "$repo" ]]; then
        echo "❌ Uso: tnrx huggingface {model|dataset} author/repo"
        exit 1
    fi

    # 2. Verificação de existência do Token
    if [[ -z "$HF_TOKEN" ]]; then
        echo "❌ Erro: Variável de ambiente HF_TOKEN não encontrada."
        echo "Adicione ao seu ~/.bashrc: export HF_TOKEN='seu_token_aqui'"
        echo "Ou adicione ao arquivo $CONFIG_FILE"
        exit 1
    fi

    # 3. Teste rápido de validade do Token (API whoami)
    echo "🔍 Validando HF_TOKEN..."
    local check_token
    check_token=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $HF_TOKEN" https://huggingface.co/api/whoami-v2)

    if [ "$check_token" != "200" ]; then
        echo "❌ Erro: HF_TOKEN inválido ou expirado (HTTP $check_token)."
        exit 1
    fi
    echo "✅ Token validado com sucesso."

    local image
    find_sif; image="$SIF"

    # Nota: Removi o 'uv sync' para tornar o download mais direto,
    # partindo do princípio que o usuário já preparou o ambiente.

    echo "🌐 [HEADNODE] Iniciando download do Hugging Face..."
    # Usamos o prefixo ENV_ do runtime do host para garantir que a env chegue
    # intacta ao container sem expor o token na linha de comando.
    export "${RUNTIME_ENV_PREFIX}HF_TOKEN=$HF_TOKEN"
    export "${RUNTIME_ENV_PREFIX}TNRX_HUB_ROOT=$HOST_HUB_ROOT"

    run_cmd "$HOST_RUNTIME" exec --bind "$bind_path" \
                   "$image" \
                   "$UV_BIN" run "$HOME/.local/bin/download_huggingface" "$type" "$repo"
    unset "${RUNTIME_ENV_PREFIX}HF_TOKEN"
    unset "${RUNTIME_ENV_PREFIX}TNRX_HUB_ROOT"
    unset_env_vars
}

do_version() {
    local commit date source
    commit=$(sed -n 's/^COMMIT=//p' "$SCRIPT_DIR/VERSION" 2>/dev/null)
    date=$(sed -n 's/^DATE=//p' "$SCRIPT_DIR/VERSION" 2>/dev/null)
    source=$(sed -n 's/^SOURCE=//p' "$SCRIPT_DIR/VERSION" 2>/dev/null)
    if [ -n "$commit" ]; then
        echo "tnrx $commit ($date), de $source"
    else
        echo "tnrx rodando direto de $SCRIPT_DIR (não instalado pelo install.sh)"
    fi
}

do_update_dev() {
    # Instala a cópia de desenvolvimento ($1, ou a pasta atual) no lugar da
    # instalação, com as mudanças ainda não commitadas.
    local src="$PWD" arg extra=()
    for arg in "$@"; do
        case "$arg" in
            --choose) extra+=(--choose) ;;
            *) src="$arg" ;;
        esac
    done
    [ -f "$src/install.sh" ] || { echo "❌ $src não é o repositório do tnrx. Uso: tnrx update-dev [pasta do repositório]" >&2; exit 1; }
    exec bash "$src/install.sh" --from "$src" "${extra[@]}"
}

# --- Lógica de Entrada ---

# Flag global de debug: pode vir antes do subcomando, em qualquer ordem/quantidade
while [[ "$1" == "--debug" || "$1" == "-x" ]]; do
    DEBUG=1
    shift
done

case $1 in
    install) shift; do_install "$@" ;;
    uv)      shift; do_uv "$@" ;;
    slurm)   shift; do_slurm "$@" ;;
    uvslurm) shift; do_uvslurm "$@" ;;
    huggingface|hf) shift; do_huggingface "$@" ;;
    update)  shift; exec bash "$SCRIPT_DIR/install.sh" --update "$@" ;;
    update-dev) shift; do_update_dev "$@" ;;
    uninstall) exec bash "$SCRIPT_DIR/install.sh" --uninstall ;;
    version|--version|-V) do_version ;;
    *)
        echo "Uso: tnrx [--debug|-x] {install|uv|slurm|uvslurm|hf|update|update-dev|uninstall|version}"
        echo "  --debug, -x                 -> Imprime o comando real (srun/singularity) antes de executá-lo"
        echo "  tnrx update                 -> Atualiza o tnrx e o tnrx-connect a partir do GitHub"
        echo "  tnrx update-dev [pasta]     -> Instala a sua cópia de desenvolvimento (padrão: a pasta atual)"
        echo "                                (update e update-dev aceitam --choose: pergunta de novo o que instalar)"
        echo "  tnrx install                -> Prepara o servidor: uv e a imagem padrão"
        echo "  tnrx install singularity    -> Liga a pasta a uma imagem do banco (do tnrx.def, se houver)"
        echo "  tnrx uv add <pkg>           -> Gerencia dependências no Headnode"
        echo "  tnrx slurm <cmd>            -> Roda comando genérico no Slurm"
        echo "  tnrx uvslurm <script>       -> Roda script Python via UV no Slurm"
        echo "  tnrx hf model author/repo -> Baixa modelo do Hugging Face"
        ;;
esac
