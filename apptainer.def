Bootstrap: docker
From: python:3.10-slim

%files
    # Copia o arquivo do host para a raiz do container
    pyproject.toml /app/pyproject.toml
    # Se tiver o lockfile, é bom copiar também para garantir reprodutibilidade
    uv.lock /app/uv.lock

%post
    # Instala dependências mínimas do sistema
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    # Instala o UV para gerenciar pacotes de forma ultra-rápida
    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

%environment
    export LC_ALL=C.UTF-8
    # Garante que o Python encontre os certificados para o download SSL
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

%help
    Container minimalista para download de modelos (HF) e gestão de ambiente via UV.