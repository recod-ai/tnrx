#!/bin/bash

# tnrx-connect: companion do `tnrx` que roda no SEU LAPTOP (não no servidor).
#
# Modo principal (mount): `mount` monta a pasta do projeto do servidor, via
# rclone/SFTP, na pasta onde o comando foi rodado; a montagem não depende de
# nenhum terminal e só termina com `umount`. `ssh` abre um terminal no servidor
# (e só confere se está montado). Só existe uma cópia dos arquivos (no servidor);
# o laptop enxerga por um mount com cache em disco. Um git "sombra" tira
# snapshots pra permitir rollback.
#
# Modo alternativo (rsync): `tnrx-connect rsync|sync|pull|init` — sincroniza uma
# cópia local com o servidor via rsync (.tnrx_connect na pasta do projeto).
#
# Nenhum dos modos instala nada no servidor: usam só ssh + SFTP/rsync.

# --- Configurações Fixas ---
CONFIG_FILE=".tnrx_connect"
CACHE_DIR="$HOME/.cache/tnrx-connect"

DEFAULT_SYNC_DELETE="true"
DEFAULT_POLL_INTERVAL="3"

# Modo mount
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tnrx-connect"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tnrx-connect"
MOUNTS_FILE="${TNRX_MOUNTS_FILE:-/proc/mounts}"

DEFAULT_CACHE_MAX_SIZE="20G"
DEFAULT_DIR_CACHE_TIME="30s"
DEFAULT_SNAPSHOT_INTERVAL="60"
DEFAULT_SNAPSHOT_MAX_FILE_MB="5"

MOUNT_WAIT_SECS="${TNRX_MOUNT_WAIT_SECS:-30}"
UNMOUNT_RETRIES="${TNRX_UNMOUNT_RETRIES:-5}"
UNMOUNT_SLEEP="${TNRX_UNMOUNT_SLEEP:-1}"
RCLONE_EXIT_WAIT_SECS="${TNRX_RCLONE_EXIT_WAIT_SECS:-120}"

DEBUG=0

# Caminho absoluto deste script (o loop de snapshots roda como um processo próprio dele)
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

# Preenchidos por load_config() (modo rsync) ou pelos prompts (modo mount)
HOST=""
REMOTE_PATH=""
SYNC_DELETE=""
POLL_INTERVAL=""
CTRL_PATH=""

# Preenchidos por do_connect_rsync()/cleanup_rsync()
WATCHER_STARTED=false
MASTER_OWNED=false
LOG_FILE=""
PID_FILE=""

# Estado do modo mount
LOCAL_DIR=""
ID=""
CONF_FILE=""
DEF_HOST=""
DEF_REMOTE=""
CONF_CACHE_MAX_SIZE=""
CONF_DIR_CACHE_TIME=""
CONF_SNAPSHOT_INTERVAL=""
CONF_SNAPSHOT_MAX_FILE_MB=""
CONF_JUPYTER_PORT=""
LOCK_DIR=""
LOCK_PID=""
OLD_MOUNT_PID=""
OLD_SNAP_PID=""
MOUNT_PID=""
SNAP_PID=""
SHADOW_DIR=""
MOUNT_LOG=""

# --- Helpers ---

debug_print() {
    if [ "$DEBUG" -eq 1 ]; then
        local part
        printf '🔎 [DEBUG] Comando real: '
        for part in "$@"; do
            printf '%q ' "$part"
        done
        printf '\n'
    fi
}

run_cmd() {
    debug_print "$@"
    "$@"
}

project_id() {
    # Hash curto do caminho absoluto do projeto, para nomear log/pidfile sem
    # colidir entre projetos de mesmo nome em pastas diferentes.
    pwd -P | cksum | awk '{print $1}'
}

compute_ctrl_path() {
    # Path do socket de multiplexação SSH (ControlMaster), por HOST: permite
    # autenticar uma vez (senha/2FA) e reaproveitar a conexão em todas as
    # chamadas seguintes, sem prompt de novo. Ver ensure_master()/resolve_ssh_cmd().
    mkdir -p "$CACHE_DIR"
    CTRL_PATH="$CACHE_DIR/ssh-$(printf '%s' "$HOST" | cksum | awk '{print $1}').sock"
}

load_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "❌ Erro: $CONFIG_FILE não encontrado nesta pasta." >&2
        echo "   Rode 'tnrx-connect init' para criar um, ou copie .tnrx_connect.example do repo do tnrx." >&2
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    SYNC_DELETE="${SYNC_DELETE:-$DEFAULT_SYNC_DELETE}"
    POLL_INTERVAL="${POLL_INTERVAL:-$DEFAULT_POLL_INTERVAL}"

    compute_ctrl_path
}

validate_config() {
    if [ -z "$HOST" ]; then
        echo "❌ Erro: HOST não definido em $CONFIG_FILE." >&2
        exit 1
    fi
    case "$REMOTE_PATH" in
        /*) ;;
        *)
            echo "❌ Erro: REMOTE_PATH precisa ser um caminho absoluto (começando com /)." >&2
            echo "   Valor atual: '$REMOTE_PATH'" >&2
            exit 1
            ;;
    esac
}

browse_remote_dir() {
    # Navega interativamente pelas pastas de $HOST via SSH (reaproveitando a
    # conexão mestra) e ecoa em stdout o caminho absoluto escolhido. Todo o
    # menu/prompt vai para stderr, então o chamador só precisa capturar
    # $(browse_remote_dir) para pegar o resultado.
    local current
    current=$(ssh -o ControlPath="$CTRL_PATH" "$HOST" 'echo $HOME' 2>/dev/null)
    [ -z "$current" ] && current="/"

    while true; do
        echo "" >&2
        echo "📂 $current" >&2

        local dirs
        dirs=$(ssh -o ControlPath="$CTRL_PATH" "$HOST" "cd '$current' 2>/dev/null && ls -1d */ 2>/dev/null | sed 's#/\$##'")

        local -a dir_array=()
        if [ -n "$dirs" ]; then
            local i=1 d
            while IFS= read -r d; do
                dir_array+=("$d")
                echo "  [$i] $d/" >&2
                ((i++))
            done <<< "$dirs"
        else
            echo "  (sem subpastas aqui, ou sem permissão pra listar)" >&2
        fi

        echo "" >&2
        echo "  [n] usar esta pasta ($current)" >&2
        echo "  [..] subir um nível" >&2
        echo "  [q] cancelar" >&2
        read -r -p "Escolha: " choice

        case "$choice" in
            n|N)
                echo "$current"
                return 0
                ;;
            ..)
                current=$(ssh -o ControlPath="$CTRL_PATH" "$HOST" "cd '$current/..' 2>/dev/null && pwd")
                ;;
            q|Q)
                return 1
                ;;
            ''|*[!0-9]*)
                echo "⚠️  Opção inválida." >&2
                ;;
            *)
                if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#dir_array[@]}" ]; then
                    current="$current/${dir_array[$((choice - 1))]}"
                else
                    echo "⚠️  Opção inválida." >&2
                fi
                ;;
        esac
    done
}

ensure_master() {
    # Autentica em $HOST uma única vez (pode pedir senha/2FA aqui) e deixa
    # uma conexão mestra aberta, multiplexada via CTRL_PATH. Toda chamada
    # ssh/rsync seguinte que usar o mesmo ControlPath reaproveita essa
    # conexão já autenticada, sem prompt de novo — inclusive as chamadas do
    # loop de sync em background, que não têm ninguém pra responder um prompt.
    if ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
        echo "🔐 Reaproveitando conexão já autenticada em $HOST (conexão mestra que ainda estava aberta)."
        return 0
    fi

    echo "🔐 Autenticando em $HOST (pode pedir senha/2FA agora — só dessa vez, nesta sessão)..."
    if ! ssh -o ControlMaster=auto -o ControlPath="$CTRL_PATH" -o ControlPersist=8h \
            -o ServerAliveInterval=30 -o ServerAliveCountMax=4 -fN "$HOST"; then
        echo "❌ Erro: não foi possível autenticar em $HOST." >&2
        exit 1
    fi
    MASTER_OWNED=true
}

resolve_ssh_cmd() {
    # Ecoa o comando ssh a usar pelo rsync (-e). Se a conexão mestra estiver
    # viva, reaproveita (sem novo prompt). Senão: em contexto de background
    # (force_batch=true) usa BatchMode=yes pra falhar rápido em vez de travar
    # esperando senha/2FA que ninguém vai digitar; em primeiro plano, deixa o
    # ssh prompt normalmente (uso pontual de `sync`/`pull` sem sessão aberta).
    local force_batch="${1:-false}"
    if ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
        echo "ssh -o ControlPath=$CTRL_PATH -o BatchMode=yes"
    elif [ "$force_batch" == "true" ]; then
        echo "ssh -o BatchMode=yes"
    else
        echo "ssh"
    fi
}

sync_once() {
    # Reusa o .gitignore do projeto como lista de exclusão do rsync (mesma
    # semântica do git: dir-merge recursivo), evitando manter uma segunda
    # lista de exclusões separada. Artefatos gerados no servidor que também
    # estão no .gitignore (.venv/, *.sif, logs/...) nunca são tocados, nem
    # enviados nem apagados pelo --delete.
    local force_batch="${1:-false}"
    local delete_flag=()
    [ "$SYNC_DELETE" == "true" ] && delete_flag=(--delete)

    run_cmd rsync -avz "${delete_flag[@]}" \
        --filter=':- .gitignore' \
        --exclude='.git/' \
        -e "$(resolve_ssh_cmd "$force_batch")" \
        "$PWD"/ "$HOST:$REMOTE_PATH"/
}

watch_loop() {
    # Polling simples: o rsync já faz diff incremental (mtime+size) por conta
    # própria, então rodar a cada poucos segundos é barato. Evita depender de
    # fswatch/inotifywait (não garantidos no laptop de todo mundo). Sempre em
    # modo batch: se a conexão mestra cair, falha rápido no log em vez de
    # travar pedindo senha/2FA num processo sem terminal.
    while true; do
        sleep "$POLL_INTERVAL"
        sync_once true
    done
}

cleanup_rsync() {
    if [ "$WATCHER_STARTED" == "true" ]; then
        sync_once true >> "$LOG_FILE" 2>&1
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
        echo "🔌 Sincronização encerrada."
    fi

    if [ "$MASTER_OWNED" == "true" ]; then
        ssh -O exit -o ControlPath="$CTRL_PATH" "$HOST" 2>/dev/null
        echo "🔒 Conexão autenticada com $HOST encerrada."
    fi
}

# --- Comandos Principais ---

do_connect_rsync() {
    load_config
    validate_config
    ensure_master

    run_cmd ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" "mkdir -p '$REMOTE_PATH'"

    echo "🔄 Sincronização inicial..."
    sync_once

    mkdir -p "$CACHE_DIR"
    local id
    id=$(project_id)
    LOG_FILE="$CACHE_DIR/${id}.log"
    PID_FILE="$CACHE_DIR/${id}.pid"

    local existing_pid=""
    [ -f "$PID_FILE" ] && existing_pid=$(cat "$PID_FILE" 2>/dev/null)

    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
        echo "📡 Sync já ativo de outra sessão neste projeto (PID $existing_pid) — reaproveitando."
        WATCHER_STARTED=false
    else
        watch_loop >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        WATCHER_STARTED=true
        echo "📡 Sync ativo em background (PID $!, a cada ${POLL_INTERVAL}s). Logs: $LOG_FILE"
    fi

    trap cleanup_rsync EXIT INT TERM

    echo "🖥️  Conectando em $HOST..."
    run_cmd ssh -t -o ControlPath="$CTRL_PATH" "$HOST" "cd '$REMOTE_PATH' && exec \$SHELL -l"
}

do_sync() {
    load_config
    validate_config
    sync_once
}

do_pull() {
    load_config
    validate_config
    echo "⬇️  Puxando de $HOST:$REMOTE_PATH para $PWD (não apaga nada local)..."
    run_cmd rsync -avz \
        --filter=':- .gitignore' \
        --exclude='.git/' \
        -e "$(resolve_ssh_cmd)" \
        "$HOST:$REMOTE_PATH"/ "$PWD"/
}

do_init() {
    if [ -f "$CONFIG_FILE" ]; then
        read -p "⚠️  $CONFIG_FILE já existe. Sobrescrever? (y/N) " resp
        [[ "$resp" != "y" ]] && { echo "Cancelado."; return; }
    fi

    read -p "HOST (alias SSH resolvível a partir deste laptop, ex. abaporu): " host
    HOST="$host"
    compute_ctrl_path

    local remote_path=""
    read -p "Navegar pelas pastas de $host pra escolher o REMOTE_PATH? (Y/n) " nav
    if [[ "$nav" != "n" && "$nav" != "N" ]]; then
        ensure_master
        remote_path=$(browse_remote_dir)
        local browse_status=$?
        [ "$MASTER_OWNED" == "true" ] && ssh -O exit -o ControlPath="$CTRL_PATH" "$HOST" 2>/dev/null
        if [ "$browse_status" -ne 0 ] || [ -z "$remote_path" ]; then
            echo "Cancelado."
            return
        fi
    else
        read -p "REMOTE_PATH (caminho absoluto do projeto no servidor): " remote_path
    fi

    cat > "$CONFIG_FILE" <<EOF
# .tnrx_connect — configuração local de sincronização (NÃO versionar)
HOST=$host
REMOTE_PATH=$remote_path
EOF
    echo "✅ $CONFIG_FILE criado (REMOTE_PATH=$remote_path)."
}

# --- Instalação (install.sh, na mesma pasta que este script) ---

TNRX_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

do_version() {
    local commit date source
    commit=$(sed -n 's/^COMMIT=//p' "$TNRX_DIR/VERSION" 2>/dev/null)
    date=$(sed -n 's/^DATE=//p' "$TNRX_DIR/VERSION" 2>/dev/null)
    source=$(sed -n 's/^SOURCE=//p' "$TNRX_DIR/VERSION" 2>/dev/null)
    if [ -n "$commit" ]; then
        echo "tnrx-connect $commit ($date), de $source"
    else
        echo "tnrx-connect rodando direto de $TNRX_DIR (não instalado pelo install.sh)"
    fi
}

do_update_dev() {
    # Instala a cópia de desenvolvimento ($1, ou a pasta atual) no lugar da
    # instalação, com as mudanças ainda não commitadas.
    local src="$PWD" arg extra=()
    for arg in "$@"; do
        case "$arg" in
            --choose) extra+=(--choose) ;;
            *) src="$arg" ;;
        esac
    done
    [ -f "$src/install.sh" ] || { echo "❌ $src não é o repositório do tnrx. Uso: tnrx-connect update-dev [pasta do repositório]" >&2; exit 1; }
    exec bash "$src/install.sh" --from "$src" "${extra[@]}"
}

# ============================================================================
# Modo mount (rclone)
# ============================================================================

LOCK_START=""
STALE_LOCK_FOUND=false
EFF_CACHE_MAX_SIZE=""
EFF_DIR_CACHE_TIME=""
EFF_SNAPSHOT_INTERVAL=""
EFF_SNAPSHOT_MAX_FILE_MB=""
RCLONE_ARGS=()

hash_of() { printf '%s' "$1" | cksum | awk '{print $1}'; }

sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9._@-' '_'; }

now_epoch() { date +%s; }

fmt_epoch() { date -d "@$1" '+%F %T' 2>/dev/null || date -r "$1" '+%F %T' 2>/dev/null || echo "$1"; }

pid_alive() {
    local pid="$1" st
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    st=$(ps -p "$pid" -o stat= 2>/dev/null | tr -d ' ')
    [ "${st:0:1}" != "Z" ]
}

pid_is_tnrx() {
    pid_alive "$1" && ps -p "$1" -o command= 2>/dev/null | grep -q 'tnrx-connect'
}

pid_is_rclone() {
    pid_alive "$1" && ps -p "$1" -o command= 2>/dev/null | grep -q 'rclone'
}

# --- Config por host_pasta (~/.config/tnrx-connect/<host>_<pasta>.conf) ---

CONF_KEYS="HOST REMOTE_PATH LOCAL_DIR LAST_USED CACHE_MAX_SIZE DIR_CACHE_TIME SNAPSHOT_INTERVAL SNAPSHOT_MAX_FILE_MB JUPYTER_PORT"

conf_get() {
    ( unset $CONF_KEYS; source "$1" >/dev/null 2>&1; printf '%s' "${!2}" )
}

find_confs_for_dir() {
    # Ecoa os .conf cuja LOCAL_DIR é a pasta dada, o mais recente primeiro.
    local dir="$1" f d t
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        d=$(conf_get "$f" LOCAL_DIR)
        [ "$d" == "$dir" ] || continue
        t=$(conf_get "$f" LAST_USED)
        printf '%s %s\n' "${t:-0}" "$f"
    done | sort -rn | cut -d' ' -f2-
}

load_optional_from_conf() {
    CONF_CACHE_MAX_SIZE=$(conf_get "$1" CACHE_MAX_SIZE)
    CONF_DIR_CACHE_TIME=$(conf_get "$1" DIR_CACHE_TIME)
    CONF_SNAPSHOT_INTERVAL=$(conf_get "$1" SNAPSHOT_INTERVAL)
    CONF_SNAPSHOT_MAX_FILE_MB=$(conf_get "$1" SNAPSHOT_MAX_FILE_MB)
    CONF_JUPYTER_PORT=$(conf_get "$1" JUPYTER_PORT)
}

set_effective() {
    EFF_CACHE_MAX_SIZE="${CONF_CACHE_MAX_SIZE:-$DEFAULT_CACHE_MAX_SIZE}"
    EFF_DIR_CACHE_TIME="${CONF_DIR_CACHE_TIME:-$DEFAULT_DIR_CACHE_TIME}"
    EFF_SNAPSHOT_INTERVAL="${CONF_SNAPSHOT_INTERVAL:-$DEFAULT_SNAPSHOT_INTERVAL}"
    EFF_SNAPSHOT_MAX_FILE_MB="${CONF_SNAPSHOT_MAX_FILE_MB:-$DEFAULT_SNAPSHOT_MAX_FILE_MB}"
}

resolve_conf_file() {
    # Nome: <host>_<pasta>.conf. Se já existir um .conf com esse nome apontando
    # pra OUTRA pasta local (mesmo nome de pasta em caminhos diferentes),
    # acrescenta um hash curto do caminho pra não colidir.
    local host_s base cand existing
    host_s=$(sanitize "$HOST")
    base=$(sanitize "$(basename "$LOCAL_DIR")")
    cand="$CONF_DIR/${host_s}_${base}.conf"
    if [ -f "$cand" ]; then
        existing=$(conf_get "$cand" LOCAL_DIR)
        if [ -n "$existing" ] && [ "$existing" != "$LOCAL_DIR" ]; then
            cand="$CONF_DIR/${host_s}_${base}-$(hash_of "$LOCAL_DIR").conf"
        fi
    fi
    CONF_FILE="$cand"
    ID=$(basename "$cand" .conf)
}

emit_opt() {
    [ -n "$2" ] && printf '%s=%q\n' "$1" "$2"
    return 0
}

save_conf() {
    mkdir -p "$CONF_DIR"
    {
        echo "# tnrx-connect (modo mount) — regravado a cada execução."
        echo "# Opcionais (adicione a linha pra mudar): CACHE_MAX_SIZE, DIR_CACHE_TIME, SNAPSHOT_INTERVAL, SNAPSHOT_MAX_FILE_MB"
        printf 'HOST=%q\n' "$HOST"
        printf 'REMOTE_PATH=%q\n' "$REMOTE_PATH"
        printf 'LOCAL_DIR=%q\n' "$LOCAL_DIR"
        printf 'LAST_USED=%s\n' "$(now_epoch)"
        emit_opt CACHE_MAX_SIZE "$CONF_CACHE_MAX_SIZE"
        emit_opt DIR_CACHE_TIME "$CONF_DIR_CACHE_TIME"
        emit_opt SNAPSHOT_INTERVAL "$CONF_SNAPSHOT_INTERVAL"
        emit_opt SNAPSHOT_MAX_FILE_MB "$CONF_SNAPSHOT_MAX_FILE_MB"
        emit_opt JUPYTER_PORT "$CONF_JUPYTER_PORT"
    } > "$CONF_FILE.tmp" && mv "$CONF_FILE.tmp" "$CONF_FILE"
}

# --- Prompts (sempre perguntam; Enter aceita o valor anterior) ---

ask() {
    local prompt="$1" def="$2" ans=""
    if [ -n "$def" ]; then
        read -r -p "$prompt [$def]: " ans
    else
        read -r -p "$prompt: " ans
    fi
    printf '%s' "${ans:-$def}"
}

select_defaults() {
    DEF_HOST=""
    DEF_REMOTE=""
    local -a confs=()
    local f
    while IFS= read -r f; do
        [ -n "$f" ] && confs+=("$f")
    done < <(find_confs_for_dir "$LOCAL_DIR")
    [ "${#confs[@]}" -eq 0 ] && return 0

    local chosen="${confs[0]}"
    if [ "${#confs[@]}" -gt 1 ]; then
        echo "Esta pasta já foi usada com mais de uma configuração (mais recente primeiro):" >&2
        local i=1
        for f in "${confs[@]}"; do
            echo "  [$i] $(conf_get "$f" HOST):$(conf_get "$f" REMOTE_PATH)" >&2
            ((i++))
        done
        local n
        n=$(ask "Usar qual" "1")
        case "$n" in
            ''|*[!0-9]*) ;;
            *) if [ "$n" -ge 1 ] && [ "$n" -le "${#confs[@]}" ]; then chosen="${confs[$((n - 1))]}"; fi ;;
        esac
    fi
    DEF_HOST=$(conf_get "$chosen" HOST)
    DEF_REMOTE=$(conf_get "$chosen" REMOTE_PATH)
    load_optional_from_conf "$chosen"
}

prompt_remote_path() {
    local def="" ans
    [ "$HOST" == "$DEF_HOST" ] && def="$DEF_REMOTE"
    if [ -n "$def" ]; then
        read -r -p "Pasta remota [$def] (Enter = manter, b = navegar): " ans
    else
        read -r -p "Pasta remota (caminho absoluto, ou b = navegar): " ans
    fi
    case "$ans" in
        b|B)
            ensure_master
            local picked
            picked=$(browse_remote_dir) || { echo "Cancelado." >&2; return 1; }
            [ -n "$picked" ] || { echo "Cancelado." >&2; return 1; }
            REMOTE_PATH="$picked"
            ;;
        *) REMOTE_PATH="${ans:-$def}" ;;
    esac
    [ "$REMOTE_PATH" != "/" ] && REMOTE_PATH="${REMOTE_PATH%/}"
    case "$REMOTE_PATH" in
        /*) return 0 ;;
        *)
            echo "❌ A pasta remota precisa ser um caminho absoluto (começando com /). Use 'b' pra navegar." >&2
            return 1
            ;;
    esac
}

# --- Estado de montagem ---

is_mounted() {
    local dir="$1"
    if [ -r "$MOUNTS_FILE" ]; then
        D="${dir// /\\040}" awk '$2 == ENVIRON["D"] { found = 1 } END { exit !found }' "$MOUNTS_FILE"
        return
    fi
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$dir" 2>/dev/null
        return
    fi
    local a b
    a=$(stat -c %d "$dir" 2>/dev/null || stat -f %d "$dir" 2>/dev/null)
    b=$(stat -c %d "$dir/.." 2>/dev/null || stat -f %d "$dir/.." 2>/dev/null)
    [ -n "$a" ] && [ "$a" != "$b" ]
}

is_rclone_mount() {
    [ -r "$MOUNTS_FILE" ] || return 0
    D="${1// /\\040}" awk '$2 == ENVIRON["D"] && $3 ~ /rclone/ { found = 1 } END { exit !found }' "$MOUNTS_FILE"
}

# --- Lock por pasta local ---

lock_dir_for() { printf '%s/locks/%s.d' "$DATA_DIR" "$(hash_of "$1")"; }

lock_get() { sed -n "s/^$2=//p" "$1/info" 2>/dev/null | head -1; }

write_lock_info() {
    # PID = execução do `tnrx-connect mount` que ainda está montando (vazio depois que
    # a montagem fica pronta: a partir daí ela não depende de nenhum terminal).
    printf 'PID=%s\nHOST=%s\nREMOTE_PATH=%s\nLOCAL_DIR=%s\nID=%s\nSTART=%s\nMOUNT_PID=%s\nSNAP_PID=%s\n' \
        "$LOCK_PID" "$HOST" "$REMOTE_PATH" "$LOCAL_DIR" "$ID" "$LOCK_START" "$MOUNT_PID" "$SNAP_PID" > "$LOCK_DIR/info"
}

lock_alive() {
    # A montagem de uma pasta está viva enquanto o rclone dela roda e a pasta está
    # montada; ou enquanto um `tnrx-connect mount` ainda está montando.
    local ld="$1"
    [ -d "$ld" ] || return 1
    pid_is_tnrx "$(lock_get "$ld" PID)" && return 0
    pid_is_rclone "$(lock_get "$ld" MOUNT_PID)" && is_mounted "$(lock_get "$ld" LOCAL_DIR)"
}

refuse_locked() {
    local ld="$1"
    echo "❌ Outra execução do tnrx-connect está montando esta pasta agora:" >&2
    echo "   pasta: $LOCAL_DIR" >&2
    echo "   host:  $(lock_get "$ld" HOST):$(lock_get "$ld" REMOTE_PATH)" >&2
    echo "   PID:   $(lock_get "$ld" PID) (desde $(fmt_epoch "$(lock_get "$ld" START)"))" >&2
}

acquire_lock() {
    mkdir -p "$DATA_DIR/locks"
    local ld
    ld=$(lock_dir_for "$LOCAL_DIR")
    if [ -d "$ld" ]; then
        if lock_alive "$ld"; then
            refuse_locked "$ld"
            return 1
        fi
        STALE_LOCK_FOUND=true
        OLD_MOUNT_PID=$(lock_get "$ld" MOUNT_PID)
        OLD_SNAP_PID=$(lock_get "$ld" SNAP_PID)
        rm -rf "$ld"
    fi
    if ! mkdir "$ld" 2>/dev/null; then
        refuse_locked "$ld"
        return 1
    fi
    LOCK_DIR="$ld"
    LOCK_PID=$$
    LOCK_START=$(now_epoch)
    MOUNT_PID="$OLD_MOUNT_PID"
    write_lock_info
}

warn_remote_in_use() {
    local info ld
    for info in "$DATA_DIR"/locks/*.d/info; do
        [ -f "$info" ] || continue
        ld=$(dirname "$info")
        [ "$(lock_get "$ld" LOCAL_DIR)" == "$LOCAL_DIR" ] && continue
        lock_alive "$ld" || continue
        if [ "$(lock_get "$ld" HOST)" == "$HOST" ] && [ "$(lock_get "$ld" REMOTE_PATH)" == "$REMOTE_PATH" ]; then
            echo "⚠️  $HOST:$REMOTE_PATH já está montado em $(lock_get "$ld" LOCAL_DIR)." >&2
            echo "   Dois mounts da mesma pasta remota têm caches separados e podem mostrar versões diferentes." >&2
        fi
    done
}

other_sessions_on_host() {
    local info ld
    for info in "$DATA_DIR"/locks/*.d/info; do
        [ -f "$info" ] || continue
        ld=$(dirname "$info")
        lock_alive "$ld" || continue
        [ "$(lock_get "$ld" HOST)" == "$HOST" ] && return 0
    done
    return 1
}

master_in_use() {
    # Fechar a conexão mestra derruba tudo que passa por ela: uma montagem viva,
    # um terminal `tnrx-connect ssh` ou uma ponte do Jupyter (exceto este processo).
    other_sessions_on_host && return 0
    local procs
    procs=$(ps -Ao pid=,ppid=,command= 2>/dev/null | awk -v me="$$" '$1 != me && $2 != me')
    printf '%s\n' "$procs" | grep -qF -- "-t -o ControlPath=$CTRL_PATH " && return 0
    local b pid
    for b in "$DATA_DIR"/bridges/*; do
        [ -f "$b" ] || continue
        pid=$(basename "$b")
        [ "$pid" == "$$" ] && continue
        if ! pid_is_tnrx "$pid"; then rm -f "$b"; continue; fi
        [ "$(sed -n 1p "$b" 2>/dev/null)" == "$HOST" ] && return 0
    done
    return 1
}

close_master_if_unused() {
    [ -n "$HOST" ] && [ -n "$CTRL_PATH" ] || return 0
    master_in_use && return 0
    if ssh -O exit -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
        echo "🔒 Conexão autenticada com $HOST encerrada."
    fi
}

find_session_root() {
    # Ecoa a pasta (a dada ou uma acima dela) que tem configuração do modo mount.
    # Com $2=alive, só aceita uma pasta que está montada agora.
    local d="$1" want="$2" f
    while [ -n "$d" ] && [ "$d" != "/" ]; do
        f=$(find_confs_for_dir "$d" | head -1)
        if [ -n "$f" ]; then
            if [ "$want" != "alive" ] || lock_alive "$(lock_dir_for "$d")"; then
                printf '%s' "$d"
                return 0
            fi
        fi
        d=$(dirname "$d")
    done
    return 1
}

# --- Montar / desmontar ---

check_mount_deps() {
    if ! command -v rclone >/dev/null 2>&1; then
        echo "❌ rclone não encontrado no PATH. Instale-o no laptop (rclone.org) e tente de novo." >&2
        return 1
    fi
    case "$(uname -s)" in
        Linux)
            if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
                echo "❌ FUSE não encontrado (fusermount3). Instale o pacote fuse3 do seu sistema." >&2
                return 1
            fi
            ;;
        Darwin)
            if [ ! -e /Library/Filesystems/macfuse.fs ] && [ ! -e /Library/Filesystems/osxfuse.fs ]; then
                echo "⚠️  macFUSE não detectado; o mount pode falhar no macOS." >&2
            fi
            ;;
    esac
    return 0
}

do_unmount_once() {
    local dir="$1" lazy="$2" cmd
    for cmd in fusermount3 fusermount; do
        if command -v "$cmd" >/dev/null 2>&1; then
            if [ "$lazy" == "lazy" ]; then "$cmd" -uz "$dir" 2>/dev/null; else "$cmd" -u "$dir" 2>/dev/null; fi
            return
        fi
    done
    if [ "$lazy" == "lazy" ]; then
        umount -l "$dir" 2>/dev/null || diskutil unmount force "$dir" >/dev/null 2>&1
    else
        umount "$dir" 2>/dev/null || diskutil unmount "$dir" >/dev/null 2>&1
    fi
}

unmount_dir() {
    local dir="$1" lazy="$2" i
    for ((i = 1; i <= UNMOUNT_RETRIES; i++)); do
        do_unmount_once "$dir" "$lazy"
        is_mounted "$dir" || return 0
        sleep "$UNMOUNT_SLEEP"
    done
    echo "⚠️  Não consegui desmontar $dir (em uso?). Quem está usando a pasta:" >&2
    if command -v fuser >/dev/null 2>&1; then
        # A linha "root kernel mount" sai sempre, pra qualquer ponto de montagem — não é
        # um bloqueio real, só ruído; filtrada pra não confundir com o que de fato segura.
        fuser -mv "$dir" 2>&1 | grep -v ' kernel *mount ' >&2
    elif command -v lsof >/dev/null 2>&1; then
        lsof +f -- "$dir" 2>/dev/null | head -10 >&2
    fi
    return 1
}

wait_rclone_exit() {
    # Não mata o rclone por padrão: ele precisa terminar de enviar as escritas
    # pendentes. $2 permite um limite menor que RCLONE_EXIT_WAIT_SECS (usado por
    # recover_previous, que depois mata o processo se o limite curto estourar).
    local pid="$1" max="${2:-$RCLONE_EXIT_WAIT_SECS}" i announced=false
    for ((i = 0; i < max; i++)); do
        pid_alive "$pid" || return 0
        if [ "$announced" == "false" ]; then
            echo "⏳ Aguardando o rclone (PID $pid) terminar de enviar escritas pendentes..."
            announced=true
        fi
        sleep 1
    done
    return 1
}

recover_previous() {
    # A sessão anterior nesta pasta terminou sem limpar (lock velho): ela já morreu de
    # verdade (o PID do dono não está mais vivo), então o que sobrou é só gente lendo o
    # mount antigo (um terminal esquecido, o Nautilus, um editor) — não tem mais ninguém
    # "usando" a pasta no sentido de uma sessão ativa. Por isso a desmontagem aqui é
    # preguiçosa (lazy): desanexa na hora e deixa os leitores antigos terminarem sozinhos,
    # sem que o usuário precise caçar e fechar cada janela primeiro.
    if is_mounted "$LOCAL_DIR"; then
        echo "⚠️  A pasta ainda estava montada por uma sessão anterior; desmontando..."
        if ! unmount_dir "$LOCAL_DIR" "lazy"; then
            echo "❌ Feche o que usa a pasta e rode: tnrx-connect umount -f" >&2
            return 1
        fi
    fi
    if [ -n "$OLD_MOUNT_PID" ] && pid_alive "$OLD_MOUNT_PID"; then
        # A pasta já foi desanexada (lazy) — se o processo antigo continua vivo, é porque
        # algo externo (Nautilus, outro terminal) ainda segura um descritor velho, o que
        # pode nunca se soltar sozinho. Isso não é motivo pra travar a sessão nova: o
        # cache em disco é persistente e o próximo mount (start_mount, logo em seguida)
        # retoma dali qualquer envio que ainda estivesse pendente — então é seguro dar um
        # empurrão no processo órfão em vez de ficar esperando por esse leitor.
        if ! wait_rclone_exit "$OLD_MOUNT_PID" "${TNRX_RECOVER_KILL_GRACE_SECS:-5}"; then
            echo "ℹ️  A sessão anterior ainda tinha algo com a pasta aberta; encerrando o processo antigo (PID $OLD_MOUNT_PID) — nada se perde, o cache é retomado agora." >&2
            kill "$OLD_MOUNT_PID" 2>/dev/null
            wait_rclone_exit "$OLD_MOUNT_PID" 5 || kill -9 "$OLD_MOUNT_PID" 2>/dev/null
        fi
    fi
    OLD_MOUNT_PID=""
    MOUNT_PID=""
    return 0
}

start_mount() {
    local vfs_dir ssh_cmd i max
    vfs_dir="$DATA_DIR/$ID/vfs-$(hash_of "$REMOTE_PATH")"
    mkdir -p "$vfs_dir"
    MOUNT_LOG="$DATA_DIR/$ID/mount.log"
    ssh_cmd="ssh -o ControlPath=$CTRL_PATH -o BatchMode=yes $HOST"

    RCLONE_ARGS=(mount ":sftp:$REMOTE_PATH" "$LOCAL_DIR"
        --vfs-cache-mode full --cache-dir "$vfs_dir"
        --vfs-cache-max-size "$EFF_CACHE_MAX_SIZE" --vfs-cache-max-age 8760h
        --dir-cache-time "$EFF_DIR_CACHE_TIME" --vfs-write-back 5s
        --sftp-connections 4 --sftp-disable-hashcheck
        --exclude '.venv/**'
        --log-file "$MOUNT_LOG" --log-level INFO)

    if [ "$DEBUG" -eq 1 ]; then
        printf '🔎 [DEBUG] RCLONE_SFTP_SSH=%q\n' "$ssh_cmd"
        debug_print rclone "${RCLONE_ARGS[@]}"
    fi

    RCLONE_SFTP_SSH="$ssh_cmd" detach rclone "${RCLONE_ARGS[@]}" </dev/null >/dev/null 2>&1
    MOUNT_PID=$!
    write_lock_info

    max=$((MOUNT_WAIT_SECS * 5))
    for ((i = 0; i < max; i++)); do
        is_mounted "$LOCAL_DIR" && return 0
        if ! pid_alive "$MOUNT_PID"; then
            echo "❌ O rclone terminou antes de montar. Fim do log ($MOUNT_LOG):" >&2
            tail -5 "$MOUNT_LOG" 2>/dev/null >&2
            MOUNT_PID=""
            return 1
        fi
        sleep 0.2
    done
    echo "❌ A montagem não ficou pronta em ${MOUNT_WAIT_SECS}s. Fim do log ($MOUNT_LOG):" >&2
    tail -5 "$MOUNT_LOG" 2>/dev/null >&2
    kill "$MOUNT_PID" 2>/dev/null
    MOUNT_PID=""
    return 1
}

# --- Git sombra (snapshots pra rollback; git-dir fora do projeto) ---

shadow_git() {
    local t=()
    command -v timeout >/dev/null 2>&1 && t=(timeout "${TNRX_SNAPSHOT_TIMEOUT:-120}")
    "${t[@]}" git --git-dir="$SHADOW_DIR" --work-tree="$LOCAL_DIR" \
        -c user.name=tnrx-connect -c user.email=tnrx-connect@localhost \
        -c core.hooksPath=/dev/null -c commit.gpgsign=false -c core.quotepath=off \
        -c core.autocrlf=false "$@"
}

init_shadow() {
    [ -d "$SHADOW_DIR" ] && return 0
    mkdir -p "$(dirname "$SHADOW_DIR")"
    git -c init.defaultBranch=main init -q --bare "$SHADOW_DIR"
}

update_shadow_excludes() {
    # Exclui do snapshot: regras do .git/info/exclude do projeto (que o git
    # sombra não enxerga) + arquivos maiores que SNAPSHOT_MAX_FILE_MB.
    local ex="$SHADOW_DIR/info/exclude" p rel
    mkdir -p "$SHADOW_DIR/info"
    {
        [ -f "$LOCAL_DIR/.git/info/exclude" ] && cat "$LOCAL_DIR/.git/info/exclude"
        find "$LOCAL_DIR" -path "$LOCAL_DIR/.git" -prune -o -type f -size +"${EFF_SNAPSHOT_MAX_FILE_MB}M" -print 2>/dev/null |
            while IFS= read -r p; do
                rel="${p#"$LOCAL_DIR"/}"
                printf '/%s\n' "$(printf '%s' "$rel" | sed 's/[][*?\\#!]/\\&/g')"
            done
        true
    } > "$ex.tmp" && mv "$ex.tmp" "$ex"
}

snapshot_once() {
    # Nunca tira snapshot se a pasta não está montada: o work-tree vazio seria
    # gravado como "todos os arquivos apagados".
    local msg="${1:-snapshot $(date '+%F %T')}" staged total deleted
    is_mounted "$LOCAL_DIR" || return 1
    init_shadow
    update_shadow_excludes
    shadow_git add -A >/dev/null 2>&1 || return 1
    staged=$(shadow_git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
    [ "${staged:-0}" -eq 0 ] && return 0

    # Proteção extra: se mais da metade dos arquivos sumiu de uma vez, é mais
    # provável um mount vazio/instável do que uma limpeza real.
    total=$(shadow_git ls-tree -r --name-only HEAD 2>/dev/null | wc -l | tr -d ' ')
    deleted=$(shadow_git diff --cached --diff-filter=D --name-only 2>/dev/null | wc -l | tr -d ' ')
    if [ "${total:-0}" -ge 10 ] && [ $((deleted * 2)) -gt "${total:-0}" ]; then
        shadow_git reset -q >/dev/null 2>&1
        echo "[$(date '+%F %T')] snapshot ignorado: $deleted de $total arquivos sumiram de uma vez (mount instável?)"
        return 2
    fi
    shadow_git commit -q -m "$msg" >/dev/null 2>&1
}

snapshot_retry() {
    local msg="$1" n
    for n in 1 2 3; do
        snapshot_once "$msg"
        [ $? -le 2 ] && return 0
        sleep 1
    done
    return 1
}

# --- Ciclo de vida da montagem ---
#
# A montagem é independente de qualquer terminal: `mount` sobe o rclone e o loop de
# snapshots desacoplados (nova sessão, sem tty) e devolve o prompt; ela continua
# até `umount`. `ssh`, `refresh`, `snapshot`, `restore`, `history` só verificam
# se a pasta está montada.

detach() {
    # Roda "$@" em background fora da sessão/grupo do terminal: fechar a aba ou um
    # Ctrl-C nela não chega ao processo. Sem setsid (macOS), ignora HUP/INT.
    if command -v setsid >/dev/null 2>&1; then
        setsid "$@" &
    else
        ( trap '' HUP INT; exec "$@" ) &
    fi
}

start_snapshot_loop() {
    detach bash "$SELF" __snapshot-loop "$LOCAL_DIR" "$MOUNT_PID" </dev/null >>"$MOUNT_LOG" 2>&1
    SNAP_PID=$!
}

stop_snapshot_loop() {
    local pid="$1" i
    pid_is_tnrx "$pid" || return 0
    kill "$pid" 2>/dev/null
    for ((i = 0; i < 20; i++)); do
        pid_alive "$pid" || return 0
        sleep 0.1
    done
}

do_snapshot_loop() {
    # Uso interno (__snapshot-loop <pasta> <pid do rclone>): tira um snapshot a cada
    # SNAPSHOT_INTERVAL segundos enquanto a montagem existir; termina sozinho quando o
    # rclone morre ou a pasta é desmontada.
    trap '' HUP INT
    load_session_for_dir "$1" || exit 1
    local mpid="$2" elapsed=0
    while pid_alive "$mpid" && is_mounted "$LOCAL_DIR"; do
        sleep 1
        elapsed=$((elapsed + 1))
        if [ "$elapsed" -ge "$EFF_SNAPSHOT_INTERVAL" ]; then
            elapsed=0
            snapshot_once
        fi
    done
}

mount_abort() {
    # Só roda se `mount` falhar no meio. Se sobrou um rclone vivo (o nosso ou o de uma
    # sessão anterior que não deu pra recuperar), o lock fica, como lock velho, pra
    # próxima execução recuperar; senão é apagado.
    trap - EXIT INT TERM HUP
    stop_snapshot_loop "$SNAP_PID"
    SNAP_PID=""
    if [ -n "$LOCK_DIR" ] && [ -d "$LOCK_DIR" ]; then
        if [ -n "$MOUNT_PID" ] && pid_alive "$MOUNT_PID"; then
            LOCK_PID=""
            write_lock_info
        else
            rm -rf "$LOCK_DIR"
            close_master_if_unused
        fi
    fi
}

check_local_dir_ready() {
    # O mount cobre a pasta local: ela precisa estar vazia (o que o SERVIDOR
    # tem não importa; é o conteúdo LOCAL que ficaria escondido).
    local entries count
    if is_mounted "$LOCAL_DIR"; then
        echo "❌ $LOCAL_DIR já é um ponto de montagem que não é do tnrx-connect." >&2
        return 1
    fi
    entries=$(ls -A "$LOCAL_DIR" 2>/dev/null)
    if [ -n "$entries" ]; then
        count=$(printf '%s\n' "$entries" | wc -l | tr -d ' ')
        echo "❌ $LOCAL_DIR não está vazia ($count itens locais):" >&2
        printf '%s\n' "$entries" | head -5 | sed 's/^/     /' >&2
        [ "$count" -gt 5 ] && echo "     ..." >&2
        echo "   O mount é montado POR CIMA desta pasta e esconderia esse conteúdo local." >&2
        echo "   O que está no servidor pode ter quantos arquivos quiser; o que precisa estar vazio é a pasta LOCAL." >&2
        echo "   Rode o comando numa pasta vazia (ex.: mkdir ~/trabalho/proj && cd ~/trabalho/proj) ou mova esse conteúdo pra outro lugar." >&2
        return 1
    fi
}

reconnect_mounted() {
    # A pasta já está montada: só garante que a conexão mestra está viva. Se ela caiu
    # (rede), reautentica; o rclone volta a usá-la nas próximas operações.
    local root="$1"
    load_session_for_dir "$root" || exit 1
    compute_ctrl_path
    if ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
        echo "✅ $LOCAL_DIR já está montada ($HOST:$REMOTE_PATH)."
        return 0
    fi
    echo "⚠️  $LOCAL_DIR está montada, mas a conexão com $HOST caiu; reautenticando..."
    ensure_master
    echo "✅ Conexão restabelecida: a pasta volta a sincronizar."
}

do_mount() {
    check_mount_deps || exit 1
    LOCAL_DIR=$(pwd -P)
    mkdir -p "$CONF_DIR" "$DATA_DIR"

    local root
    if root=$(find_session_root "$LOCAL_DIR" alive); then
        reconnect_mounted "$root"
        return 0
    fi
    case "$LOCAL_DIR" in
        /|"$HOME")
            echo "❌ Rode em uma pasta de projeto dedicada (não em / nem na sua home): ela vira o ponto de montagem." >&2
            exit 1
            ;;
    esac
    # Com lock velho (montagem que caiu) a pasta pode ainda ter o mount antigo:
    # recover_previous cuida disso mais adiante; a checagem final vale nos dois casos.
    if [ ! -d "$(lock_dir_for "$LOCAL_DIR")" ]; then
        check_local_dir_ready || exit 1
    fi

    select_defaults
    HOST=$(ask "Host (user@servidor ou alias do ~/.ssh/config)" "$DEF_HOST")
    if [ -z "$HOST" ]; then
        echo "❌ O host é obrigatório." >&2
        exit 1
    fi
    compute_ctrl_path
    case "$CTRL_PATH" in
        *" "*)
            echo "❌ O caminho do socket SSH tem espaço ($CTRL_PATH); o rclone não aceita isso. Defina HOME sem espaços." >&2
            exit 1
            ;;
    esac
    prompt_remote_path || exit 1
    resolve_conf_file
    set_effective
    SHADOW_DIR="$DATA_DIR/$ID/shadow.git"
    MOUNT_LOG="$DATA_DIR/$ID/mount.log"
    mkdir -p "$DATA_DIR/$ID"

    cd / || exit 1
    acquire_lock || exit 1
    trap mount_abort EXIT
    trap 'exit 130' INT TERM HUP
    save_conf
    warn_remote_in_use

    ensure_master

    if [ "$STALE_LOCK_FOUND" == "true" ]; then
        stop_snapshot_loop "$OLD_SNAP_PID"
        recover_previous || exit 1
    fi
    check_local_dir_ready || exit 1

    echo "📦 Montando $HOST:$REMOTE_PATH em $LOCAL_DIR ..."
    start_mount || exit 1
    start_snapshot_loop
    LOCK_PID=""
    write_lock_info
    trap - EXIT INT TERM HUP
    # Senha fixa do Jupyter deste projeto (vale também pra um Jupyter iniciado à mão no servidor).
    push_jupyter_token "$REMOTE_PATH"

    echo "✅ Montado. A pasta continua montada até você rodar: tnrx-connect umount"
    echo "   Cache persistente: $DATA_DIR/$ID/ (log: $MOUNT_LOG)"
    echo "🖥️  Terminal do servidor: tnrx-connect ssh   |   Claude Code/editor: cd '$LOCAL_DIR' && claude"
    echo "⚠️  Qualquer terminal que já estava DENTRO desta pasta antes de montar (inclusive este)"
    echo "   continua vendo a pasta vazia de antes: rode 'cd .' (ou reabra o terminal) pra enxergar o mount."
    echo "📸 Snapshots a cada ${EFF_SNAPSHOT_INTERVAL}s — veja: tnrx-connect history | tnrx-connect restore <id>"
}

do_ssh() {
    # Terminal SSH no servidor, na pasta remota que corresponde à pasta local atual.
    # Não monta nada: só confere que a pasta está montada e a conexão está viva.
    local start="${1:-$(pwd -P)}" root sub target
    if ! root=$(find_session_root "$start"); then
        echo "❌ Nenhuma pasta do tnrx-connect aqui ($start)." >&2
        echo "   Monte o projeto primeiro: tnrx-connect mount (ou só tnrx-connect, que monta e abre o terminal)." >&2
        exit 1
    fi
    load_session_for_dir "$root" || exit 1
    if ! lock_alive "$LOCK_DIR"; then
        echo "❌ $LOCAL_DIR não está montada. Monte com: cd '$LOCAL_DIR' && tnrx-connect mount" >&2
        exit 1
    fi
    compute_ctrl_path
    if ! ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
        echo "❌ A conexão autenticada com $HOST caiu (rede?)." >&2
        echo "   Rode tnrx-connect mount (pede senha/2FA de novo e a pasta volta a sincronizar)." >&2
        exit 1
    fi
    sub="${start#"$root"}"
    target="$REMOTE_PATH$sub"
    echo "🖥️  Conectando em $HOST ($target)..."
    run_cmd ssh -t -o ControlPath="$CTRL_PATH" "$HOST" "cd $(printf '%q' "$target") && exec \$SHELL -l"
    if lock_alive "$LOCK_DIR"; then
        echo "ℹ️  $LOCAL_DIR continua montada. Para desmontar: tnrx-connect umount"
    else
        # A pasta foi desmontada enquanto este terminal estava aberto.
        close_master_if_unused
    fi
}

do_connect() {
    # Sem argumentos: monta (se ainda não estiver montada) e abre o terminal SSH.
    # Sair do terminal NÃO desmonta.
    local start
    start=$(pwd -P)
    do_mount
    do_ssh "$start"
}

# --- Subcomandos que operam sobre a pasta (atual ou informada) ---

load_session_for_dir() {
    local f
    LOCAL_DIR=$(cd "${1:-.}" 2>/dev/null && pwd -P) || {
        echo "❌ Pasta inválida: ${1:-.}" >&2
        return 1
    }
    f=$(find_confs_for_dir "$LOCAL_DIR" | head -1)
    if [ -z "$f" ]; then
        echo "❌ Nenhuma configuração do tnrx-connect (modo mount) registrada para $LOCAL_DIR." >&2
        return 1
    fi
    CONF_FILE="$f"
    ID=$(basename "$f" .conf)
    HOST=$(conf_get "$f" HOST)
    REMOTE_PATH=$(conf_get "$f" REMOTE_PATH)
    load_optional_from_conf "$f"
    set_effective
    SHADOW_DIR="$DATA_DIR/$ID/shadow.git"
    MOUNT_LOG="$DATA_DIR/$ID/mount.log"
    LOCK_DIR=$(lock_dir_for "$LOCAL_DIR")
}

do_snapshot() {
    load_session_for_dir "" || exit 1
    if snapshot_once "${1:-snapshot manual $(date '+%F %T')}"; then
        echo "📸 Snapshot registrado (ou sem mudanças desde o último)."
    else
        echo "❌ Não foi possível tirar o snapshot (a pasta está montada?)." >&2
        exit 1
    fi
}

do_history() {
    load_session_for_dir "" || exit 1
    if [ ! -d "$SHADOW_DIR" ]; then
        echo "Nenhum snapshot ainda."
        return 0
    fi
    local out
    out=$(shadow_git log --pretty=format:'%h  %ad  %s' --date=format:'%Y-%m-%d %H:%M:%S' -n 30 -- "$@" 2>/dev/null)
    if [ -z "$out" ]; then
        echo "Nenhum snapshot ainda."
    else
        printf '%s\n' "$out"
    fi
}

do_restore() {
    local commit="$1" n
    if [ -z "$commit" ]; then
        echo "Uso: tnrx-connect restore <snapshot> [arquivo-ou-pasta ...]" >&2
        exit 1
    fi
    shift
    load_session_for_dir "" || exit 1
    if [ ! -d "$SHADOW_DIR" ]; then
        echo "❌ Nenhum snapshot ainda." >&2
        exit 1
    fi
    if ! is_mounted "$LOCAL_DIR"; then
        echo "❌ A pasta não está montada; restaurar escreve nela. Monte com 'tnrx-connect mount'." >&2
        exit 1
    fi
    if ! shadow_git rev-parse --verify --quiet "$commit^{commit}" >/dev/null 2>&1; then
        echo "❌ Snapshot inexistente: $commit (veja 'tnrx-connect history')." >&2
        exit 1
    fi
    snapshot_once "snapshot antes de restaurar $commit" >/dev/null 2>&1
    local -a paths=("$@")
    [ "${#paths[@]}" -eq 0 ] && paths=(":(top)")
    for n in 1 2 3; do
        if shadow_git checkout "$commit" -- "${paths[@]}"; then
            echo "♻️  Restaurado de $commit. (Arquivos criados depois desse snapshot não são apagados.)"
            return 0
        fi
        sleep 1
    done
    echo "❌ Não consegui restaurar (o snapshot automático pode estar rodando; tente de novo)." >&2
    exit 1
}

do_status() {
    if [ "$1" == "--json" ]; then
        JSON=true
        mkdir -p "$CONF_DIR" "$DATA_DIR"
        do_status_json
        return 0
    fi
    load_session_for_dir "$1" || exit 1
    local mpid cache_dir count last
    echo "Pasta:     $LOCAL_DIR"
    echo "Config:    $CONF_FILE"
    echo "Servidor:  $HOST:$REMOTE_PATH"
    mpid=$(lock_get "$LOCK_DIR" MOUNT_PID)
    if lock_alive "$LOCK_DIR"; then
        echo "Montada:   sim (rclone PID $mpid, desde $(fmt_epoch "$(lock_get "$LOCK_DIR" START)"))"
        compute_ctrl_path
        if ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
            echo "Conexão:   ativa"
        else
            echo "Conexão:   caiu — rode 'tnrx-connect mount' pra reautenticar"
        fi
    elif is_mounted "$LOCAL_DIR"; then
        echo "Montada:   sim, mas o rclone não está rodando — rode 'tnrx-connect mount' pra recuperar"
    else
        echo "Montada:   não"
    fi
    cache_dir="$DATA_DIR/$ID/vfs-$(hash_of "$REMOTE_PATH")"
    if [ -d "$cache_dir" ]; then
        echo "Cache:     $cache_dir ($(du -sh "$cache_dir" 2>/dev/null | cut -f1), limite $EFF_CACHE_MAX_SIZE)"
    else
        echo "Cache:     ainda não criado"
    fi
    if [ -d "$SHADOW_DIR" ]; then
        count=$(shadow_git rev-list --count HEAD 2>/dev/null || echo 0)
        last=$(shadow_git log -1 --pretty=format:'%ad' --date=format:'%Y-%m-%d %H:%M:%S' 2>/dev/null)
        echo "Snapshots: ${count:-0}${last:+ (último: $last)}"
    else
        echo "Snapshots: nenhum"
    fi
}

do_refresh() {
    load_session_for_dir "" || exit 1
    local mpid
    mpid=$(lock_get "$LOCK_DIR" MOUNT_PID)
    if ! lock_alive "$LOCK_DIR" || ! pid_alive "$mpid"; then
        echo "❌ A pasta não está montada. Monte com: tnrx-connect mount" >&2
        exit 1
    fi
    kill -HUP "$mpid"
    echo "🔄 Cache de diretórios limpo (rclone PID $mpid): o que mudou no servidor aparece no próximo acesso."
}

do_unmount() {
    # Desmonta a pasta: snapshot final, desmontagem, espera o rclone enviar o que está
    # pendente e fecha a conexão mestra se nada mais a usa.
    local a dir_arg="" lazy="" ld mpid spid root have_conf=false
    for a in "$@"; do
        case "$a" in
            -f|--force) lazy="lazy" ;;
            *) dir_arg="$a" ;;
        esac
    done
    LOCAL_DIR=$(cd "${dir_arg:-.}" 2>/dev/null && pwd -P) || {
        echo "❌ Pasta inválida: ${dir_arg:-.}" >&2
        exit 1
    }
    # Rodado de uma subpasta da montagem: desmonta a pasta montada acima dela.
    if [ -z "$dir_arg" ] && root=$(find_session_root "$LOCAL_DIR"); then
        LOCAL_DIR="$root"
    fi
    if [ -n "$(find_confs_for_dir "$LOCAL_DIR" | head -1)" ]; then
        load_session_for_dir "$LOCAL_DIR" || exit 1
        have_conf=true
    fi
    cd / || exit 1
    ld=$(lock_dir_for "$LOCAL_DIR")
    LOCK_DIR="$ld"
    if pid_is_tnrx "$(lock_get "$ld" PID)"; then
        echo "❌ Esta pasta está sendo montada agora (PID $(lock_get "$ld" PID)); espere terminar." >&2
        exit 1
    fi
    mpid=$(lock_get "$ld" MOUNT_PID)
    spid=$(lock_get "$ld" SNAP_PID)
    [ -d "$ld" ] && HOST=$(lock_get "$ld" HOST)
    [ -n "$HOST" ] && compute_ctrl_path

    if ! is_mounted "$LOCAL_DIR"; then
        echo "ℹ️  $LOCAL_DIR não está montada."
        stop_snapshot_loop "$spid"
        if [ -n "$mpid" ] && pid_alive "$mpid" && ! wait_rclone_exit "$mpid"; then
            echo "⚠️  O rclone (PID $mpid) ainda está enviando escritas pendentes; elas ficam no cache." >&2
            return 0
        fi
        rm -rf "$ld"
        close_master_if_unused
        return 0
    fi
    if [ ! -d "$ld" ] && ! is_rclone_mount "$LOCAL_DIR"; then
        echo "❌ $LOCAL_DIR está montada, mas não parece um mount do rclone/tnrx-connect; não vou mexer." >&2
        exit 1
    fi

    stop_snapshot_loop "$spid"
    [ "$have_conf" == "true" ] && snapshot_retry "snapshot final $(date '+%F %T')" >/dev/null 2>&1
    echo "🔌 Desmontando $LOCAL_DIR..."
    if ! unmount_dir "$LOCAL_DIR" "$lazy"; then
        echo "❌ Ainda em uso. Feche o que aparece acima (ou saia da pasta com cd ~), ou use: tnrx-connect umount ${dir_arg:-.} -f" >&2
        echo "   O -f desmonta na hora, sem esperar essas janelas fecharem, e não afeta os arquivos." >&2
        echo "   A pasta continua montada; nada foi perdido." >&2
        # Continua montada: os snapshots automáticos voltam a rodar.
        if [ "$have_conf" == "true" ] && pid_alive "$mpid" && [ -d "$ld" ]; then
            MOUNT_PID="$mpid"
            start_snapshot_loop
            sed -i.bak "s/^SNAP_PID=.*/SNAP_PID=$SNAP_PID/" "$ld/info" && rm -f "$ld/info.bak"
        fi
        exit 1
    fi
    echo "✅ $LOCAL_DIR desmontada."
    if [ -n "$mpid" ] && pid_alive "$mpid" && ! wait_rclone_exit "$mpid"; then
        # O lock fica (velho): o próximo mount nesta pasta retoma o envio pelo cache.
        # A conexão mestra também fica: o rclone ainda precisa dela pra enviar.
        echo "⚠️  O rclone (PID $mpid) segue enviando escritas pendentes; elas ficam no cache e não se perdem." >&2
        return 0
    fi
    rm -rf "$ld"
    close_master_if_unused
}

# --- Jupyter: ponte local -> nó de computação pela conexão SSH mestra ---

FWD_SPEC=""

port_in_use() { (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null; }

host_label() {
    # Rótulo DNS (a-z0-9-) do host, sem "user@": recod-headnode, abaporu...
    local h="${1##*@}"
    h=$(printf '%s' "$h" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
    printf '%s' "${h:-host}"
}

parse_jupyter_target() {
    # Aceita a URL que o Jupyter imprimiu (http://nó:porta/lab?token=...),
    # "nó:porta", "nó porta" ou só "nó" (porta 8888). Preenche J_NODE/J_PORT/J_PATH.
    local in="$1"
    local re_url='^https?://([^/:?#]+)(:([0-9]+))?(/.*)?$'
    local re_np='^([^[:space:]:/]+)[[:space:]:]+([0-9]+)$'
    local re_node='^[^[:space:]:/]+$'
    J_NODE=""; J_PORT=""; J_PATH=""
    if [[ "$in" =~ $re_url ]]; then
        J_NODE="${BASH_REMATCH[1]}"; J_PORT="${BASH_REMATCH[3]}"; J_PATH="${BASH_REMATCH[4]}"
    elif [[ "$in" =~ $re_np ]]; then
        J_NODE="${BASH_REMATCH[1]}"; J_PORT="${BASH_REMATCH[2]}"
    elif [[ "$in" =~ $re_node ]]; then
        J_NODE="$in"
    else
        return 1
    fi
    case "$J_NODE" in
        127.0.0.1|localhost|0.0.0.0|"[::1]")
            echo "ℹ️  A URL usa '$J_NODE' (o Jupyter imprime duas); preciso do nome do NÓ (linha 'Nó: ...' do tnrx)." >&2
            J_NODE=$(ask "Nó" "")
            ;;
    esac
    J_PORT="${J_PORT:-8888}"
    J_PATH="${J_PATH:-/lab}"
    [[ "$J_NODE" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]] || { echo "❌ Nome de nó inválido: '$J_NODE'." >&2; return 1; }
    [[ "$J_PORT" =~ ^[0-9]+$ ]] && [ "$J_PORT" -ge 1 ] && [ "$J_PORT" -le 65535 ] || { echo "❌ Porta inválida: '$J_PORT'." >&2; return 1; }
}

register_bridge() {
    # Marca este `tnrx-connect jupyter` como usuário da conexão mestra de $HOST, pra um
    # umount (ou outra ponte) não fechá-la debaixo dele. Linhas: host, nó, porta, porta local
    # (as três últimas depois que a ponte abre; `jupyter list` mostra quais estão abertas).
    mkdir -p "$DATA_DIR/bridges"
    printf '%s\n%s\n%s\n%s\n' "$HOST" "$J_NODE" "$J_PORT" "$LOCAL_PORT" > "$DATA_DIR/bridges/$$"
}

cleanup_jupyter() {
    trap - EXIT INT TERM HUP
    rm -f "$DATA_DIR/bridges/$$"
    if [ -n "$FWD_SPEC" ] && [ "$JSON_STREAM" == "true" ]; then
        json_event closed ",\"reason\":$(json_str "${BRIDGE_END_REASON:-signal}")"
    fi
    if [ -n "$FWD_SPEC" ]; then
        ssh -O cancel -L "$FWD_SPEC" -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1
        FWD_SPEC=""
    fi
    [ "$MASTER_OWNED" == "true" ] && close_master_if_unused
}

jupyter_defaults() {
    # Sugestões de host/pasta remota. Se esta pasta (ou uma pasta acima dela) é uma
    # sessão do tnrx-connect, usa o host e a pasta remota dela (JUP_FROM_SESSION=true);
    # senão, o .conf mais recente.
    DEF_HOST=""; DEF_REMOTE=""; JUP_FROM_SESSION=false
    local d="$LOCAL_DIR" f=""
    while [ -n "$d" ] && [ "$d" != "/" ]; do
        f=$(find_confs_for_dir "$d" | head -1)
        [ -n "$f" ] && { JUP_FROM_SESSION=true; break; }
        d=$(dirname "$d")
    done
    [ -z "$f" ] && f=$(ls -t "$CONF_DIR"/*.conf 2>/dev/null | head -1)
    if [ -n "$f" ]; then
        DEF_HOST=$(conf_get "$f" HOST)
        DEF_REMOTE=$(conf_get "$f" REMOTE_PATH)
    fi
}

open_bridge() {
    # Usa J_NODE/J_PORT/HOST/CTRL_PATH. Começa pela porta $1 (padrão: a mesma do
    # servidor); se ocupada, a próxima livre.
    local lp="${1:-$J_PORT}" first="${1:-$J_PORT}" tries=0
    FWD_SPEC=""
    while [ "$tries" -lt 50 ]; do
        if ! port_in_use "$lp" && ssh -O forward -L "localhost:$lp:$J_NODE:$J_PORT" -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; then
            FWD_SPEC="localhost:$lp:$J_NODE:$J_PORT"
            LOCAL_PORT="$lp"
            [ -f "$DATA_DIR/bridges/$$" ] && register_bridge
            return 0
        fi
        lp=$((lp + 1)); tries=$((tries + 1))
    done
    echo "❌ Não consegui abrir uma porta local (tentei $first a $((first + 49))). A conexão com $HOST está ativa?" >&2
    return 1
}

print_bridge() {
    # $1 = caminho com token (ex.: /lab?token=...)
    local label
    label="$J_NODE.$(host_label "$HOST").localhost"
    echo "🔗 Ponte aberta: localhost:$LOCAL_PORT  ->  $J_NODE:$J_PORT  (via $HOST)"
    echo "🌐 Abra no navegador:  http://$label:$LOCAL_PORT$1"
    echo "   Programas que não resolvem *.localhost (ex.: VS Code): http://127.0.0.1:$LOCAL_PORT$1"
}

# --- Senha fixa e porta local fixa por projeto (pra o VS Code lembrar do servidor) ---

sha256_hex() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-64; else shasum -a 256 | cut -c1-64; fi
}

jupyter_token() {
    # Senha fixa do Jupyter de um projeto: hash de um segredo aleatório deste laptop
    # (~/.config/tnrx-connect/jupyter.secret, 600, criado uma vez) + host + pasta remota.
    # Sempre a mesma pro mesmo projeto, e ninguém consegue deduzi-la sem o segredo.
    local f="$CONF_DIR/jupyter.secret"
    if [ ! -s "$f" ]; then
        mkdir -p "$CONF_DIR"
        ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$f.tmp" && mv "$f.tmp" "$f" )
    fi
    printf '%s|%s|%s' "$(cat "$f")" "$1" "$2" | sha256_hex | cut -c1-48
}

push_jupyter_token() {
    # Grava a senha fixa do projeto $1 no servidor, em .tnrx/jupyter/token (600; a pasta
    # .tnrx tem .gitignore próprio). É de lá que o `tnrx uvslurm jupyter` a lê. A senha vai
    # pelo stdin, nunca pela linha de comando (visível pra outros usuários no `ps`).
    local remote='[ -d "$1" ] || exit 1; umask 077; d="$1/.tnrx"; mkdir -p "$d/jupyter" || exit 1
[ -e "$d/.gitignore" ] || printf "*\n" > "$d/.gitignore"
cat > "$d/jupyter/token"'
    jupyter_token "$HOST" "$1" | ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" \
        "bash -c $(printf '%q' "$remote") bash $(printf '%q' "$1")" >/dev/null 2>&1
}

conf_for_remote() {
    # .conf (deste host) cuja pasta remota é $1
    local f
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        [ "$(conf_get "$f" HOST)" == "$HOST" ] && [ "$(conf_get "$f" REMOTE_PATH)" == "$1" ] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

known_projects() {
    # Pastas remotas deste host que este laptop conhece (os .conf), começando por $1.
    local f p
    printf '%s\n' "$1"
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        [ "$(conf_get "$f" HOST)" == "$HOST" ] || continue
        p=$(conf_get "$f" REMOTE_PATH)
        [ -n "$p" ] && [ "$p" != "$1" ] && printf '%s\n' "$p"
    done | awk '!seen[$0]++'
}

conf_set() {
    # Troca (ou acrescenta) só a linha KEY=valor de um .conf.
    local f="$1"
    { grep -v "^$2=" "$f" 2>/dev/null; printf '%s=%q\n' "$2" "$3"; } > "$f.tmp" && mv "$f.tmp" "$f"
}

project_local_port() {
    # Porta local fixa do projeto $1 (guardada no .conf como JUPYTER_PORT): a URL do
    # VS Code fica sempre a mesma. Projeto sem .conf neste laptop: a porta do servidor.
    local f p
    if f=$(conf_for_remote "$1"); then
        p=$(conf_get "$f" JUPYTER_PORT)
        [ -z "$p" ] && p=$((18000 + $(hash_of "$HOST|$1") % 1000))
        printf '%s' "$p"
    else
        printf '%s' "$J_PORT"
    fi
}

jupyter_alive() {
    # O Jupyter em $1:$2 ainda responde? (testado a partir do servidor, pela conexão mestra)
    ssh -o ControlPath="$CTRL_PATH" "$HOST" "timeout 3 bash -c 'exec 3<>/dev/tcp/$1/$2'" >/dev/null 2>&1
}

bridge_wait() {
    # Mantém a ponte até a conexão mestra cair (e, com $1=watch, até o Jupyter parar).
    local watch="$1" last live="${TNRX_JUPYTER_LIVE_SECS:-30}"
    last=$(now_epoch)
    while ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; do
        sleep "${TNRX_JUPYTER_POLL_SECS:-3}" &
        wait $!
        if [ "$watch" == "watch" ] && [ $(( $(now_epoch) - last )) -ge "$live" ]; then
            last=$(now_epoch)
            if ! jupyter_alive "$J_NODE" "$J_PORT"; then
                BRIDGE_END_REASON=server_stopped
                echo "🛑 O Jupyter em $J_NODE:$J_PORT terminou; a ponte foi fechada." >&2
                return 0
            fi
        fi
    done
    BRIDGE_END_REASON=connection_lost
    echo "⚠️  A conexão SSH com $HOST foi encerrada; a ponte caiu." >&2
}

discover_jupyters() {
    # Lê, no servidor, os registros .tnrx/jupyter/*.env das pastas de projeto dadas e
    # devolve os que ainda respondem, um por linha: TNRXJ|nó|porta|token|job|início|projeto.
    # Registros de servidores parados há mais de 1 dia são apagados. O arquivo é
    # lido como texto (nunca executado) e só vale se for do próprio usuário. Para o
    # mesmo nó:porta, só o registro mais recente.
    local args="" p
    for p in "$@"; do args+=" $(printf '%q' "$p")"; done
    ssh -o ControlPath="$CTRL_PATH" "$HOST" "bash -s --$args" 2>/dev/null <<'REMOTE'
now=$(date +%s); t=""; command -v timeout >/dev/null 2>&1 && t="timeout 3"
# Jobs vivos do usuário: um registro cujo job já saiu da fila é velho, mesmo que outro
# Jupyter tenha subido depois no mesmo nó:porta. Sem squeue, vale só o teste da porta.
jobs=""
command -v squeue >/dev/null 2>&1 && jobs=$(squeue -h -u "$USER" -o %i 2>/dev/null) && jobs=" $(printf '%s' "$jobs" | tr '\n' ' ') "
{
for proj in "$@"; do
reg="$proj/.tnrx/jupyter"
[ -d "$reg" ] || continue
for f in "$reg"/*.env; do
    [ -f "$f" ] && [ -O "$f" ] || continue
    node=$(sed -n 's/^NODE=//p' "$f" | head -1); port=$(sed -n 's/^PORT=//p' "$f" | head -1)
    token=$(sed -n 's/^TOKEN=//p' "$f" | head -1); job=$(sed -n 's/^JOBID=//p' "$f" | head -1)
    started=$(sed -n 's/^STARTED=//p' "$f" | head -1)
    case "$node" in ""|*[!A-Za-z0-9._-]*) continue ;; esac
    case "$port" in ""|*[!0-9]*) continue ;; esac
    case "$token" in ""|*[!0-9a-fA-F]*) continue ;; esac
    case "$job" in *[!0-9A-Za-z_-]*) job="" ;; esac
    case "$started" in ""|*[!0-9]*) started=$now ;; esac
    alive=false
    $t bash -c "exec 3<>/dev/tcp/$node/$port" 2>/dev/null && alive=true
    case "$job" in ""|*[!0-9_]*) ;; *) [ -n "$jobs" ] && [[ "$jobs" != *" $job "* ]] && alive=false ;; esac
    if [ "$alive" == "true" ]; then
        echo "TNRXJ|$node|$port|$token|$job|$started|$proj"
    elif [ $((now - started)) -gt 86400 ]; then
        rm -f "$f"
    fi
done
done
} | sort -t'|' -k6 -rn | awk -F'|' '!seen[$2 "|" $3]++'
exit 0
REMOTE
}

fmt_age() {
    local s=$(( $(now_epoch) - $1 ))
    [ "$s" -lt 0 ] && s=0
    if [ "$s" -lt 120 ]; then echo "${s}s"
    elif [ "$s" -lt 7200 ]; then echo "$((s / 60)) min"
    else echo "$((s / 3600)) h"
    fi
}

# --- Iniciar um Jupyter novo no servidor, a partir do laptop ---

J_LAUNCH_PID=""
J_PICKED=""

launch_cancel() {
    trap - INT TERM HUP
    [ "$JSON_STREAM" == "true" ] || echo
    if [ -n "$J_LAUNCH_PID" ]; then
        if [ "$JSON_STREAM" == "true" ]; then json_event cancelled ""; else echo "🛑 Cancelando o Jupyter que estava sendo iniciado..."; fi
        # O tnrx foi iniciado numa sessão própria (setsid): o grupo inteiro (tnrx + srun) recebe o TERM.
        ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" "kill -TERM -- -$J_LAUNCH_PID" >/dev/null 2>&1
        J_LAUNCH_PID=""
    fi
    exit 130
}

launch_jupyter() {
    # Roda `tnrx uvslurm jupyter lab` na pasta $1 do servidor, fora de qualquer terminal
    # (nohup + setsid no headnode), e espera o Jupyter registrar que está no ar.
    # Deixa a linha do registro em J_PICKED. Ctrl-C enquanto espera cancela o job.
    local project="$1" out ts tag msg phase st alive log waited=0 shown=-1 started
    push_jupyter_token "$project" || json_fail prepare_failed "Não consegui preparar $HOST:$project (a pasta existe no servidor?)."
    out=$(ssh -o ControlPath="$CTRL_PATH" "$HOST" "bash -s -- $(printf '%q' "$project")" 2>/dev/null <<'REMOTE'
cd "$1" 2>/dev/null || { echo "TNRXERR|a pasta $1 não existe no servidor."; exit 0; }
t=$(command -v tnrx 2>/dev/null)
[ -z "$t" ] && [ -x "$HOME/.local/bin/tnrx" ] && t="$HOME/.local/bin/tnrx"
[ -n "$t" ] || { echo "TNRXERR|o tnrx não foi encontrado no servidor (veja docs/tnrx.md, Instalação)."; exit 0; }
command -v setsid >/dev/null 2>&1 || { echo "TNRXERR|setsid não encontrado no servidor."; exit 0; }
umask 077; mkdir -p .tnrx/jupyter
ts=$(date +%s)
nohup setsid "$t" uvslurm jupyter lab > .tnrx/jupyter/launch.log 2>&1 < /dev/null &
echo "TNRXL|$!|$ts"
REMOTE
)
    out=$(printf '%s\n' "$out" | grep -E '^TNRX(L|ERR)\|' | tail -1)
    IFS='|' read -r tag J_LAUNCH_PID ts <<< "$out"
    if [ "$tag" != "TNRXL" ]; then
        msg="${J_LAUNCH_PID:-sem resposta do servidor}"
        J_LAUNCH_PID=""
        json_fail launch_failed "Não consegui iniciar o Jupyter: $msg"
    fi
    case "$J_LAUNCH_PID$ts" in ""|*[!0-9]*) J_LAUNCH_PID=""; json_fail launch_failed "Resposta inesperada do servidor." ;; esac
    trap launch_cancel INT TERM HUP
    if [ "$JSON_STREAM" == "true" ]; then
        json_event launching ",\"host\":$(json_str "$HOST"),\"project\":$(json_str "$project"),\"log\":$(json_str "$project/.tnrx/jupyter/launch.log")"
    else
        echo "🚀 Iniciando o Jupyter em $HOST:$project (tnrx uvslurm jupyter lab). Ctrl-C cancela."
    fi

    started=$(now_epoch)
    while true; do
        J_PICKED=$(discover_jupyters "$project" | grep '^TNRXJ|' |
            awk -F'|' -v ts="$ts" '$6 >= ts' | sort -t'|' -k6 -rn | head -1)
        [ -n "$J_PICKED" ] && break
        st=$(ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" \
            "kill -0 $J_LAUNCH_PID 2>/dev/null && echo ALIVE; tail -n 20 $(printf '%q' "$project/.tnrx/jupyter/launch.log") 2>/dev/null" 2>/dev/null)
        alive=false
        [ "$(printf '%s\n' "$st" | head -1)" == "ALIVE" ] && alive=true
        log=$(printf '%s\n' "$st" | grep -v '^ALIVE$')
        if [ "$alive" != "true" ]; then
            # Pode ter registrado entre a busca e esta checagem.
            J_PICKED=$(discover_jupyters "$project" | grep '^TNRXJ|' |
                awk -F'|' -v ts="$ts" '$6 >= ts' | sort -t'|' -k6 -rn | head -1)
            [ -n "$J_PICKED" ] && break
            J_LAUNCH_PID=""
            json_fail tnrx_failed "O tnrx terminou sem subir o Jupyter. Fim do log ($project/.tnrx/jupyter/launch.log):
$(printf '%s\n' "$log" | tail -8 | sed 's/^/   /')"
        fi
        waited=$(( $(now_epoch) - started ))
        if [ $((waited / 10)) -ne "$shown" ]; then
            shown=$((waited / 10))
            if printf '%s\n' "$log" | grep -q 'queued and waiting'; then phase=queued; msg="job na fila do Slurm"
            elif printf '%s\n' "$log" | grep -qE 'has been allocated|Nó:'; then phase=starting; msg="job alocado, Jupyter subindo"
            else phase=preparing; msg="preparando o job"
            fi
            if [ "$JSON_STREAM" == "true" ]; then
                json_event waiting ",\"phase\":$(json_str "$phase"),\"elapsed\":$waited"
            else
                echo "⏳ $msg... (${waited}s)"
            fi
        fi
        sleep "${TNRX_JUPYTER_START_POLL_SECS:-3}" &
        wait $!
    done
    J_LAUNCH_PID=""
    trap 'exit 130' INT TERM HUP
    [ "$JSON_STREAM" == "true" ] || echo "✅ Jupyter no ar."
}

do_jupyter() {
    mkdir -p "$CONF_DIR" "$DATA_DIR"
    LOCAL_DIR=$(pwd -P)
    jupyter_defaults

    case "$1" in
        list)    shift; do_jupyter_list "$@" ;;
        start)   shift; do_jupyter_start "$@" ;;
        connect) shift; do_jupyter_connect "$@" ;;
        stop)    shift; do_cancel_job "$@" ;;
        "")      do_jupyter_auto ;;
        *)       do_jupyter_manual "$@" ;;
    esac
}

do_jupyter_manual() {
    # Ponte para um Jupyter que você já tem a URL: tnrx-connect jupyter <URL|nó:porta>
    HOST=$(ask "Host (user@servidor ou alias do ~/.ssh/config)" "$DEF_HOST")
    if [ -z "$HOST" ]; then
        echo "❌ O host é obrigatório." >&2
        exit 1
    fi
    local target="$*"
    parse_jupyter_target "$target" || {
        echo "❌ Não entendi '$target'. Use a URL do Jupyter, 'nó:porta' ou 'nó'." >&2
        exit 1
    }
    compute_ctrl_path

    ensure_master
    trap cleanup_jupyter EXIT
    trap 'exit 130' INT TERM HUP
    register_bridge

    open_bridge || exit 1
    [ "$LOCAL_PORT" != "$J_PORT" ] && echo "   (a porta local $J_PORT já estava em uso; usando $LOCAL_PORT)"
    print_bridge "$J_PATH"
    echo "⏳ A ponte fica ativa enquanto este comando rodar. Ctrl-C fecha."
    echo "   Se der 'Connection refused': confira nó e porta e se o Jupyter ainda está rodando."
    bridge_wait
}

do_jupyter_auto() {
    # Lista os Jupyters no ar (do projeto atual e dos outros projetos deste host que este
    # laptop conhece) e conecta no escolhido, ou inicia um novo no projeto atual.
    local project
    if [ "$JUP_FROM_SESSION" == "true" ]; then
        HOST="$DEF_HOST"; project="$DEF_REMOTE"
    else
        HOST=$(ask "Host (user@servidor ou alias do ~/.ssh/config)" "$DEF_HOST")
        project=$(ask "Pasta do projeto no servidor (onde você rodou o tnrx)" "$DEF_REMOTE")
    fi
    if [ -z "$HOST" ]; then
        echo "❌ O host é obrigatório." >&2
        exit 1
    fi
    case "$project" in
        /*) ;;
        *) echo "❌ A pasta do projeto precisa ser um caminho absoluto (começando com /)." >&2; exit 1 ;;
    esac
    [ "$project" != "/" ] && project="${project%/}"
    compute_ctrl_path

    echo "🔎 Procurando servidores Jupyter no ar em $HOST ..."
    ensure_master
    trap cleanup_jupyter EXIT
    trap 'exit 130' INT TERM HUP
    register_bridge

    local -a projects=() lines=()
    local l
    while IFS= read -r l; do projects+=("$l"); done < <(known_projects "$project")
    while IFS= read -r l; do
        [ -n "$l" ] && lines+=("$l")
    done < <(discover_jupyters "${projects[@]}" | grep '^TNRXJ|' | sort -t'|' -k6 -rn)

    local name ans pick i=1 tag node port token job started proj mark
    name=$(basename "$project")
    J_PICKED=""
    if [ "${#lines[@]}" -eq 0 ]; then
        echo "Nenhum servidor Jupyter no ar em $HOST (nos projetos que este laptop conhece)."
        printf 'Iniciar um novo Jupyter em %s (%s)? [S/n]: ' "$name" "$project" >&2
        if ! read -r ans; then ans=n; echo >&2; fi
        case "$ans" in
            ""|s|S|y|Y) launch_jupyter "$project" ;;
            *)
                echo "   Para iniciar um depois: tnrx-connect jupyter (ou, no servidor, tnrx uvslurm jupyter lab)." >&2
                exit 1
                ;;
        esac
    else
        echo "Servidores Jupyter no ar em $HOST (mais recente primeiro):"
        for l in "${lines[@]}"; do
            IFS='|' read -r tag node port token job started proj <<< "$l"
            mark=""
            [ "$proj" == "$project" ] && mark="  ← este projeto"
            echo "  [$i] $(basename "$proj")  $node:$port  (job ${job:-?}, há $(fmt_age "$started"))$mark"
            i=$((i + 1))
        done
        echo "  [n] Iniciar um novo Jupyter em $name ($project)"
        pick=$(ask "Conectar em qual" "1")
        case "$pick" in
            n|N) launch_jupyter "$project" ;;
            ''|*[!0-9]*) pick=1 ;;
        esac
        if [ -z "$J_PICKED" ]; then
            if [ "$pick" -lt 1 ] || [ "$pick" -gt "${#lines[@]}" ]; then
                echo "❌ Opção inválida: $pick." >&2
                exit 1
            fi
            J_PICKED="${lines[$((pick - 1))]}"
        fi
    fi
    connect_picked
}

connect_picked() {
    # Abre a ponte pro Jupyter em J_PICKED, na porta local fixa do projeto dele.
    local tag node port token job started proj want conf
    IFS='|' read -r tag node port token job started proj <<< "$J_PICKED"
    J_NODE="$node"; J_PORT="$port"
    want=$(project_local_port "$proj")
    open_bridge "$want" 2>/dev/null || json_fail bridge_failed "Não consegui abrir uma porta local a partir de $want (a conexão com $HOST está ativa?)."
    if [ "$JSON_STREAM" == "true" ]; then
        conf=$(conf_for_remote "$proj") && [ -z "$(conf_get "$conf" JUPYTER_PORT)" ] && conf_set "$conf" JUPYTER_PORT "$LOCAL_PORT"
        json_event bridge ",\"host\":$(json_str "$HOST"),\"project\":$(json_str "$proj"),\"fixed_port\":$(json_bool "$([ "$LOCAL_PORT" == "$want" ] && echo true)"),\"label_url\":$(json_str "http://$J_NODE.$(host_label "$HOST").localhost:$LOCAL_PORT/lab?token=$token"),\"server\":$(server_json "$J_PICKED")"
        bridge_wait watch 2>/dev/null
        exit 0
    fi
    if conf=$(conf_for_remote "$proj"); then
        if [ -z "$(conf_get "$conf" JUPYTER_PORT)" ]; then
            conf_set "$conf" JUPYTER_PORT "$LOCAL_PORT"
        elif [ "$LOCAL_PORT" != "$want" ]; then
            echo "⚠️  A porta fixa deste projeto ($want) está em uso no laptop; usando $LOCAL_PORT só desta vez (a URL do VS Code muda)."
        fi
    elif [ "$LOCAL_PORT" != "$J_PORT" ]; then
        echo "   (a porta local $J_PORT já estava em uso; usando $LOCAL_PORT)"
    fi
    print_bridge "/lab?token=$token"
    if [ "$token" == "$(jupyter_token "$HOST" "$proj")" ] && conf_for_remote "$proj" >/dev/null; then
        echo "📌 Esta URL é fixa para $(basename "$proj"): no VS Code, configure uma vez (Existing Jupyter Server) e depois só escolha o servidor."
    else
        echo "ℹ️  Este Jupyter não usa a senha fixa do projeto (foi iniciado antes dela, ou o tnrx do servidor está desatualizado); a URL vale só para ele."
    fi
    echo "⏳ A ponte fica ativa enquanto o Jupyter estiver no ar (job ${job:-?}). Ctrl-C fecha a ponte; o Jupyter continua no servidor."
    echo "   Para encerrar o Jupyter: no terminal do servidor (tnrx-connect ssh), scancel ${job:-<job>}"
    bridge_wait watch
}

# --- Interface para ferramentas (--json): extensão do VS Code e afins ---
#
# Com --json nenhum comando pergunta nada nem autentica: sem conexão mestra viva o
# erro é not_connected (a autenticação, com 2FA, é sempre num terminal: tnrx-connect
# mount). Comandos de resposta única imprimem um objeto {"v":1,"ok":...}; os de longa
# duração (jupyter start/connect) imprimem um evento JSON por linha. Contrato completo
# em docs/tnrx-connect-json.md.

JSON=false
JSON_STREAM=false
BRIDGE_END_REASON=""

# Padrões do tnrx (servidor) quando o tnrx_slurm.conf não define a chave. Um teste
# confere que continuam iguais aos DEFAULT_* do script tnrx.
SLURM_KEYS="PARTITION GPUS CPUS MEM TIME"
SLURM_DEFAULT_PARTITION="l40s"
SLURM_DEFAULT_GPUS="1"
SLURM_DEFAULT_CPUS="2"
SLURM_DEFAULT_MEM="4G"
SLURM_DEFAULT_TIME="00:10:00"

json_str() {
    local s="$1"
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
    printf '"%s"' "$s"
}

json_num() { if [[ "$1" =~ ^-?[0-9]+$ ]]; then printf '%s' "$1"; else printf 'null'; fi; }

json_bool() { if [ "$1" == "true" ]; then printf 'true'; else printf 'false'; fi; }

json_str_or_null() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }

json_event() {
    # $1 = nome do evento, $2 = campos extras já em JSON (",..." ou vazio)
    printf '{"v":1,"event":%s%s}\n' "$(json_str "$1")" "$2"
}

json_fail() {
    # $1 código, $2 mensagem, $3 código de saída (padrão 1). Em modo JSON também vai
    # pro stdout (objeto de erro, ou evento "error" nos comandos de eventos).
    if [ "$JSON_STREAM" == "true" ]; then
        json_event error ",\"code\":$(json_str "$1"),\"message\":$(json_str "$2")"
    elif [ "$JSON" == "true" ]; then
        printf '{"v":1,"ok":false,"error":{"code":%s,"message":%s}}\n' "$(json_str "$1")" "$(json_str "$2")"
    fi
    echo "❌ $2" >&2
    exit "${3:-1}"
}

master_alive() { ssh -O check -o ControlPath="$CTRL_PATH" "$HOST" >/dev/null 2>&1; }

connect_master() {
    # Em modo JSON nunca autentica: exige a conexão que o `mount` abriu.
    compute_ctrl_path
    if [ "$JSON" == "true" ]; then
        master_alive || json_fail not_connected "Sem conexão com $HOST. Rode tnrx-connect mount numa pasta deste host (pede senha/2FA)." 3
    else
        ensure_master
    fi
}

all_hosts() {
    # Hosts de todos os .conf, sem repetir.
    local f
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] && conf_get "$f" HOST && echo
    done | awk 'NF && !seen[$0]++'
}

mounted_hosts() {
    # Hosts que têm alguma pasta montada agora (pelo lock: a mesma pasta local pode ter
    # .conf de outros hosts, que não estão montados).
    local f d ld
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        d=$(conf_get "$f" LOCAL_DIR)
        [ -n "$d" ] || continue
        ld=$(lock_dir_for "$d")
        lock_alive "$ld" && lock_get "$ld" HOST && echo
    done | awk 'NF && !seen[$0]++'
}

parse_api_opts() {
    # Opções comuns: --json, --host H, --project P, --job J. O resto fica em API_ARGS.
    API_HOST=""; API_PROJECT=""; API_JOB=""; API_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) JSON=true ;;
            --host) API_HOST="$2"; shift ;;
            --project) API_PROJECT="$2"; shift ;;
            --job) API_JOB="$2"; shift ;;
            *) API_ARGS+=("$1") ;;
        esac
        shift
    done
}

resolve_api_host() {
    # --host, ou o host da pasta montada onde o comando foi rodado.
    if [ -n "$API_HOST" ]; then HOST="$API_HOST"; return 0; fi
    LOCAL_DIR=$(pwd -P)
    jupyter_defaults
    if [ "$JUP_FROM_SESSION" == "true" ]; then
        HOST="$DEF_HOST"
        [ -z "$API_PROJECT" ] && API_PROJECT="$DEF_REMOTE"
        return 0
    fi
    json_fail usage "Informe --host (ou rode dentro de uma pasta montada)." 2
}

read_quick() {
    # Lê um arquivo da pasta montada sem travar se a conexão estiver ruim.
    if command -v timeout >/dev/null 2>&1; then timeout 3 cat -- "$1" 2>/dev/null; else cat -- "$1" 2>/dev/null; fi
}

slurm_json() {
    # Valores efetivos do tnrx_slurm.conf (arquivo + padrões do tnrx) de uma pasta montada.
    local file="$1/tnrx_slurm.conf" content="" exists=false line k v out="" key def from
    if content=$(read_quick "$file") && [ -e "$file" ]; then exists=true; fi
    for key in $SLURM_KEYS; do
        v=""; from=false
        while IFS= read -r line; do
            line="${line%%#*}"
            [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
            k="${BASH_REMATCH[2]}"
            [ "$k" == "$key" ] || continue
            v="${BASH_REMATCH[3]}"
            v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
            v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
            from=true
        done <<< "$content"
        def="SLURM_DEFAULT_$key"
        [ "$from" == "true" ] || v="${!def}"
        out+="${out:+,}$(json_str "$key"):{\"value\":$(json_str "$v"),\"from_file\":$(json_bool "$from")}"
    done
    printf '{"file":%s,"exists":%s,"values":{%s}}' "$(json_str "$file")" "$(json_bool "$exists")" "$out"
}

do_status_json() {
    # Todas as pastas que este laptop conhece, com estado da montagem e da conexão.
    local f d ld rp mine state connected mpid since first=true host checked="|" alive="|" h
    printf '{"v":1,"ok":true,"mounts":['
    for f in "$CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        d=$(conf_get "$f" LOCAL_DIR)
        HOST=$(conf_get "$f" HOST)
        [ -n "$d" ] && [ -n "$HOST" ] || continue
        compute_ctrl_path
        if [[ "$checked" != *"|$HOST|"* ]]; then
            checked+="$HOST|"
            master_alive && alive+="$HOST|"
        fi
        connected=false
        [[ "$alive" == *"|$HOST|"* ]] && connected=true
        ld=$(lock_dir_for "$d")
        rp=$(conf_get "$f" REMOTE_PATH)
        mpid=""; since=""; mine=false
        # A mesma pasta local pode ter configurações de hosts diferentes: só conta a do lock.
        [ "$(lock_get "$ld" HOST)" == "$HOST" ] && [ "$(lock_get "$ld" REMOTE_PATH)" == "$rp" ] && mine=true
        if [ -d "$ld" ] && [ "$mine" == "true" ] && pid_is_tnrx "$(lock_get "$ld" PID)"; then
            state=mounting
        elif lock_alive "$ld"; then
            if [ "$mine" == "true" ]; then
                state=mounted; mpid=$(lock_get "$ld" MOUNT_PID); since=$(lock_get "$ld" START)
            else
                state=unmounted
            fi
        elif is_mounted "$d" && { [ "$mine" == "true" ] || [ ! -d "$ld" ]; }; then
            state=stale
        else
            state=unmounted
        fi
        [ "$first" == "true" ] || printf ','
        first=false
        printf '{"id":%s,"name":%s,"local_dir":%s,"host":%s,"remote_path":%s,"state":%s,"connected":%s,"rclone_pid":%s,"since":%s,"last_used":%s,"jupyter_port":%s,"log":%s,"slurm":' \
            "$(json_str "$(basename "$f" .conf)")" "$(json_str "$(basename "$d")")" "$(json_str "$d")" \
            "$(json_str "$HOST")" "$(json_str "$rp")" "$(json_str "$state")" \
            "$(json_bool "$connected")" "$(json_num "$mpid")" "$(json_num "$since")" \
            "$(json_num "$(conf_get "$f" LAST_USED)")" "$(json_num "$(conf_get "$f" JUPYTER_PORT)")" \
            "$(json_str "$DATA_DIR/$(basename "$f" .conf)/mount.log")"
        if [ "$state" == "mounted" ] && [ "$connected" == "true" ]; then slurm_json "$d"; else printf 'null'; fi
        printf '}'
    done
    printf '],"hosts":['
    first=true
    while IFS= read -r h; do
        [ "$first" == "true" ] || printf ','
        first=false
        printf '{"host":%s,"connected":%s}' "$(json_str "$h")" "$(json_bool "$([[ "$alive" == *"|$h|"* ]] && echo true)")"
    done < <(printf '%s' "$checked" | tr '|' '\n' | awk 'NF')
    printf ']}\n'
}

# --- Cluster: sinfo + meus jobs, pela conexão mestra ---

cluster_query() {
    # Saída bruta do servidor: P|partição|disponível|limite|A/I/O/T|gres, N|<scontrol show
    # node -o>, J|id|partição|nome|estado|tempo|limite|motivo|pasta, E|erro, END|.
    ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" "bash -s" 2>/dev/null <<'REMOTE'
command -v sinfo >/dev/null 2>&1 || { echo "E|sinfo não encontrado no servidor"; echo "END|"; exit 0; }
sinfo -h -o 'P|%P|%a|%l|%F|%G' 2>/dev/null
scontrol show node -o 2>/dev/null | sed 's/^/N|/'
squeue -h -u "$USER" -o 'J|%i|%P|%j|%T|%M|%l|%R|%Z' 2>/dev/null
echo "END|"
REMOTE
}

cluster_gpus() {
    # GPUs por partição a partir das linhas N| (CfgTRES/AllocTRES gres/gpu): G|partição|total|usadas|indisponíveis
    awk '
    function gpu(s,   arr, k, n) { n = split(s, arr, ","); for (k = 1; k <= n; k++) if (arr[k] ~ /^gres\/gpu=/) { sub(/^gres\/gpu=/, "", arr[k]); return arr[k] + 0 } return 0 }
    /^N\|/ {
        part = ""; st = ""; cfg = 0; alloc = 0
        n = split(substr($0, 3), kv, " ")
        for (i = 1; i <= n; i++) {
            eq = index(kv[i], "="); if (!eq) continue
            key = substr(kv[i], 1, eq - 1); val = substr(kv[i], eq + 1)
            if (key == "Partitions") part = val
            else if (key == "State") st = val
            else if (key == "CfgTRES") cfg = gpu(val)
            else if (key == "AllocTRES") alloc = gpu(val)
        }
        bad = (st ~ /DOWN|DRAIN|FAIL|NOT_RESPONDING|MAINT|RESERVED|INVALID/)
        np = split(part, ps, ",")
        for (j = 1; j <= np; j++) {
            p = ps[j]; seen[p] = 1; tot[p] += cfg
            if (bad) un[p] += cfg - alloc; used[p] += alloc
        }
    }
    END { for (p in seen) print "G|" p "|" tot[p] + 0 "|" used[p] + 0 "|" un[p] + 0 }'
}

cluster_host_json() {
    # Um host: {"host","connected","ok",["error"],"partitions":[...],"jobs":[...]}
    local raw err line tag name avail limit nodes gres def a i o t g gl gt gu gx first
    local id part jname st elapsed jlimit reason wdir
    compute_ctrl_path
    if ! master_alive; then
        printf '{"host":%s,"connected":false,"ok":false,"error":{"code":"not_connected","message":%s},"partitions":[],"jobs":[]}' \
            "$(json_str "$HOST")" "$(json_str "Sem conexão com $HOST. Rode tnrx-connect mount numa pasta deste host.")"
        return
    fi
    raw=$(cluster_query)
    if ! printf '%s\n' "$raw" | grep -q '^END|'; then
        printf '{"host":%s,"connected":true,"ok":false,"error":{"code":"query_failed","message":"o servidor não respondeu"},"partitions":[],"jobs":[]}' "$(json_str "$HOST")"
        return
    fi
    err=$(printf '%s\n' "$raw" | sed -n 's/^E|//p' | head -1)
    if [ -n "$err" ]; then
        printf '{"host":%s,"connected":true,"ok":false,"error":{"code":"no_slurm","message":%s},"partitions":[],"jobs":[]}' "$(json_str "$HOST")" "$(json_str "$err")"
        return
    fi
    gl=$(printf '%s\n' "$raw" | cluster_gpus)
    # O sinfo quebra uma partição em várias linhas (uma por estado dos nós): soma por partição.
    raw=$(printf '%s\n' "$raw" | awk -F'|' '
        /^P\|/ {
            name = $2; def = (name ~ /\*$/); sub(/\*$/, "", name)
            if (!(name in seen)) { seen[name] = 1; order[++n] = name; av[name] = $3; lim[name] = $4; d[name] = def; g[name] = "" }
            split($5, f, "/"); A[name] += f[1]; I[name] += f[2]; O[name] += f[3]; T[name] += f[4]
            if ($6 != "(null)" && $6 != "" && index("," g[name] ",", "," $6 ",") == 0) g[name] = (g[name] == "" ? $6 : g[name] "," $6)
            next
        }
        { print }
        END { for (k = 1; k <= n; k++) { x = order[k]; print "P|" x (d[x] ? "*" : "") "|" av[x] "|" lim[x] "|" A[x] "/" I[x] "/" O[x] "/" T[x] "|" (g[x] == "" ? "(null)" : g[x]) } }')
    printf '{"host":%s,"connected":true,"ok":true,"partitions":[' "$(json_str "$HOST")"
    first=true
    while IFS='|' read -r tag name avail limit nodes gres; do
        [ "$tag" == "P" ] || continue
        def=false
        [[ "$name" == *"*" ]] && { def=true; name="${name%\*}"; }
        IFS=/ read -r a i o t <<< "$nodes"
        [ "$gres" == "(null)" ] && gres=""
        g=$(printf '%s\n' "$gl" | awk -F'|' -v p="$name" '$2 == p { print $3 "|" $4 "|" $5; exit }')
        [ "$first" == "true" ] || printf ','
        first=false
        printf '{"name":%s,"default":%s,"available":%s,"time_limit":%s,"nodes":{"allocated":%s,"idle":%s,"other":%s,"total":%s},"gres":%s,"gpus":' \
            "$(json_str "$name")" "$(json_bool "$def")" "$(json_str "$avail")" "$(json_str "$limit")" \
            "$(json_num "$a")" "$(json_num "$i")" "$(json_num "$o")" "$(json_num "$t")" "$(json_str_or_null "$gres")"
        if [ -n "$g" ]; then
            IFS='|' read -r gt gu gx <<< "$g"
            printf '{"total":%s,"used":%s,"unavailable":%s,"free":%s}' "$gt" "$gu" "$gx" "$(( gt - gu - gx < 0 ? 0 : gt - gu - gx ))"
        else
            printf 'null'
        fi
        printf '}'
    done <<< "$raw"
    printf '],"jobs":['
    first=true
    while IFS='|' read -r tag id part jname st elapsed jlimit reason wdir; do
        [ "$tag" == "J" ] || continue
        [ "$first" == "true" ] || printf ','
        first=false
        printf '{"id":%s,"partition":%s,"name":%s,"state":%s,"elapsed":%s,"time_limit":%s,"reason":%s,"work_dir":%s}' \
            "$(json_str "$id")" "$(json_str "$part")" "$(json_str "$jname")" "$(json_str "$st")" \
            "$(json_str "$elapsed")" "$(json_str "$jlimit")" "$(json_str "$reason")" "$(json_str "$wdir")"
    done <<< "$raw"
    printf ']}'
}

print_cluster_text() {
    # Versão de terminal, a partir do JSON de um host (sem depender de jq).
    local raw="$1"
    if ! command -v python3 >/dev/null 2>&1; then printf '%s\n' "$raw"; return; fi
    printf '%s' "$raw" | python3 -c '
import json, sys
h = json.load(sys.stdin)
print(h["host"])
if not h["ok"]:
    print("  ⚠️  " + h["error"]["message"]); sys.exit(0)
print("  %-14s %-6s %-12s %-14s %s" % ("PARTIÇÃO", "ESTADO", "NÓS livres", "GPUs livres", "LIMITE"))
for p in h["partitions"]:
    n = p["nodes"]; g = p["gpus"]
    gp = "%d/%d" % (g["free"], g["total"]) if g else "-"
    print("  %-14s %-6s %-12s %-14s %s" % (p["name"] + ("*" if p["default"] else ""), p["available"], "%s/%s" % (n["idle"], n["total"]), gp, p["time_limit"]))
if h["jobs"]:
    print("  Meus jobs:")
    for j in h["jobs"]:
        print("    %-10s %-10s %-16s %-10s %-10s %s" % (j["id"], j["partition"], j["name"][:16], j["state"], j["elapsed"], j["reason"]))
else:
    print("  Meus jobs: nenhum")
'
}

do_cluster() {
    # tnrx-connect cluster [--host H] [--json]      -> sinfo + meus jobs
    # tnrx-connect cluster cancel <job> [--host H] [--json]
    mkdir -p "$CONF_DIR" "$DATA_DIR"
    if [ "$1" == "cancel" ]; then
        shift
        do_cancel_job "$@"
        return
    fi
    parse_api_opts "$@"
    local -a hosts=()
    local h out first=true
    if [ -n "$API_HOST" ]; then
        hosts=("$API_HOST")
    else
        while IFS= read -r h; do hosts+=("$h"); done < <(mounted_hosts)
    fi
    if [ "${#hosts[@]}" -eq 0 ] && [ "$JSON" != "true" ]; then
        echo "Nenhuma pasta montada. Use --host <host> ou monte um projeto (tnrx-connect mount)."
        return 0
    fi
    [ "$JSON" == "true" ] && printf '{"v":1,"ok":true,"hosts":['
    for h in "${hosts[@]}"; do
        HOST="$h"
        out=$(cluster_host_json)
        if [ "$JSON" == "true" ]; then
            [ "$first" == "true" ] || printf ','
            first=false
            printf '%s' "$out"
        else
            print_cluster_text "$out"
        fi
    done
    [ "$JSON" == "true" ] && printf ']}\n'
    return 0
}

do_cancel_job() {
    # Cancela um job seu (scancel) no host. Usado por `cluster cancel` e `jupyter stop`.
    parse_api_opts "$@"
    local job="${API_JOB:-${API_ARGS[0]}}" out
    [[ "$job" =~ ^[0-9]+(_[0-9]+)?$ ]] || json_fail usage "Job inválido: '$job'." 2
    resolve_api_host
    connect_master
    if ! out=$(ssh -o ControlPath="$CTRL_PATH" -o BatchMode=yes "$HOST" "scancel $job" 2>&1); then
        json_fail scancel_failed "scancel $job falhou em $HOST: $out"
    fi
    if [ "$JSON" == "true" ]; then
        printf '{"v":1,"ok":true,"host":%s,"job":%s}\n' "$(json_str "$HOST")" "$(json_str "$job")"
    else
        echo "🛑 Job $job cancelado em $HOST."
    fi
    [ "$MASTER_OWNED" == "true" ] && close_master_if_unused
    return 0
}

# --- Jupyter para ferramentas: list / start / connect / stop ---

bridge_for() {
    # Porta local de uma ponte viva (de qualquer tnrx-connect jupyter) pra $HOST $1:$2.
    local b pid
    for b in "$DATA_DIR"/bridges/*; do
        [ -f "$b" ] || continue
        pid=$(basename "$b")
        pid_is_tnrx "$pid" || continue
        if [ "$(sed -n 1p "$b")" == "$HOST" ] && [ "$(sed -n 2p "$b")" == "$1" ] && [ "$(sed -n 3p "$b")" == "$2" ]; then
            sed -n 4p "$b"
            return 0
        fi
    done
    return 1
}

server_json() {
    # Um servidor (linha TNRXJ|...) em JSON, com a URL local (da ponte aberta, ou a fixa prevista).
    local tag node port token job started proj lp open=false fixed=false
    IFS='|' read -r tag node port token job started proj <<< "$1"
    if lp=$(bridge_for "$node" "$port"); then open=true; else lp=$(J_PORT="$port" project_local_port "$proj"); fi
    [ "$token" == "$(jupyter_token "$HOST" "$proj")" ] && fixed=true
    printf '{"node":%s,"port":%s,"job":%s,"started":%s,"token":%s,"token_fixed":%s,"bridge_open":%s,"local_port":%s,"url":%s}' \
        "$(json_str "$node")" "$(json_num "$port")" "$(json_str "$job")" "$(json_num "$started")" \
        "$(json_str "$token")" "$(json_bool "$fixed")" "$(json_bool "$open")" "$(json_num "$lp")" \
        "$(json_str "http://127.0.0.1:$lp/lab?token=$token")"
}

do_jupyter_list() {
    # Jupyters no ar por host e por projeto (os projetos que este laptop conhece).
    parse_api_opts "$@"
    local -a hosts=() projects=() lines=()
    local h p l f firsth=true firstp firsts ld
    if [ -n "$API_HOST" ]; then hosts=("$API_HOST"); else while IFS= read -r h; do hosts+=("$h"); done < <(all_hosts); fi
    [ "$JSON" == "true" ] && printf '{"v":1,"ok":true,"hosts":['
    for h in "${hosts[@]}"; do
        HOST="$h"; compute_ctrl_path
        projects=(); lines=()
        while IFS= read -r p; do [ -n "$p" ] && projects+=("$p"); done < <(known_projects "" | awk 'NF')
        local connected=false
        if master_alive; then
            connected=true
            [ "${#projects[@]}" -gt 0 ] && while IFS= read -r l; do lines+=("$l"); done < <(discover_jupyters "${projects[@]}" | grep '^TNRXJ|' | sort -t'|' -k6 -rn)
        fi
        if [ "$JSON" == "true" ]; then
            [ "$firsth" == "true" ] || printf ','
            firsth=false
            printf '{"host":%s,"connected":%s,"projects":[' "$(json_str "$h")" "$(json_bool "$connected")"
            firstp=true
            for p in "${projects[@]}"; do
                ld=""; f=$(conf_for_remote "$p") && ld=$(conf_get "$f" LOCAL_DIR)
                [ "$firstp" == "true" ] || printf ','
                firstp=false
                printf '{"name":%s,"remote_path":%s,"local_dir":%s,"servers":[' "$(json_str "$(basename "$p")")" "$(json_str "$p")" "$(json_str_or_null "$ld")"
                firsts=true
                for l in "${lines[@]}"; do
                    [ "$(printf '%s' "$l" | cut -d'|' -f7-)" == "$p" ] || continue
                    [ "$firsts" == "true" ] || printf ','
                    firsts=false
                    server_json "$l"
                done
                printf ']}'
            done
            printf ']}'
        else
            echo "$h$([ "$connected" == "true" ] || echo ' (sem conexão)')"
            for p in "${projects[@]}"; do
                echo "  $(basename "$p")  ($p)"
                for l in "${lines[@]}"; do
                    [ "$(printf '%s' "$l" | cut -d'|' -f7-)" == "$p" ] || continue
                    IFS='|' read -r _ node port _ job started _ <<< "$l"
                    echo "    $node:$port  (job ${job:-?}, há $(fmt_age "$started"))"
                done
            done
        fi
    done
    [ "$JSON" == "true" ] && printf ']}\n'
    return 0
}

require_project() {
    case "$API_PROJECT" in
        /*) [ "$API_PROJECT" != "/" ] && API_PROJECT="${API_PROJECT%/}" ;;
        *) json_fail usage "Informe --project <pasta remota absoluta> (ou rode dentro de uma pasta montada)." 2 ;;
    esac
}

do_jupyter_start() {
    # Inicia um Jupyter no projeto. Texto: inicia e conecta. JSON: eventos até "ready" (não abre ponte).
    parse_api_opts "$@"
    [ "$JSON" == "true" ] && JSON_STREAM=true
    resolve_api_host
    require_project
    connect_master
    trap cleanup_jupyter EXIT
    trap 'exit 130' INT TERM HUP
    launch_jupyter "$API_PROJECT"
    if [ "$JSON" == "true" ]; then
        json_event ready ",\"host\":$(json_str "$HOST"),\"project\":$(json_str "$API_PROJECT"),\"server\":$(server_json "$J_PICKED")"
        exit 0
    fi
    register_bridge
    connect_picked
}

do_jupyter_connect() {
    # Abre a ponte (porta local fixa do projeto) pro Jupyter --job (ou o mais recente) do projeto.
    parse_api_opts "$@"
    [ "$JSON" == "true" ] && JSON_STREAM=true
    resolve_api_host
    require_project
    connect_master
    trap cleanup_jupyter EXIT
    trap 'exit 130' INT TERM HUP
    register_bridge
    J_PICKED=$(discover_jupyters "$API_PROJECT" | grep '^TNRXJ|' | sort -t'|' -k6 -rn |
        awk -F'|' -v j="$API_JOB" 'j == "" || $5 == j { print; exit }')
    [ -n "$J_PICKED" ] || json_fail no_server "Nenhum Jupyter no ar em $HOST:$API_PROJECT${API_JOB:+ com o job $API_JOB}."
    connect_picked
}

# --- Lógica de Entrada ---

while [[ "$1" == "--debug" || "$1" == "-x" ]]; do
    DEBUG=1
    shift
done

case "$1" in
    connect|"") shift; do_connect ;;
    mount)      shift; do_mount ;;
    ssh)        shift; do_ssh ;;
    umount|unmount) shift; do_unmount "$@" ;;
    status)     shift; do_status "$@" ;;
    cluster)    shift; do_cluster "$@" ;;
    refresh)    shift; do_refresh ;;
    jupyter)    shift; do_jupyter "$@" ;;
    snapshot)   shift; do_snapshot "$@" ;;
    history)    shift; do_history "$@" ;;
    restore)    shift; do_restore "$@" ;;
    __snapshot-loop) shift; do_snapshot_loop "$@" ;;
    rsync)      shift; do_connect_rsync ;;
    sync)       shift; do_sync ;;
    pull)       shift; do_pull ;;
    init)       shift; do_init ;;
    update)     shift; exec bash "$TNRX_DIR/install.sh" --update "$@" ;;
    update-dev) shift; do_update_dev "$@" ;;
    uninstall)  exec bash "$TNRX_DIR/install.sh" --uninstall ;;
    version|--version|-V) do_version ;;
    *)
        echo "Uso: tnrx-connect [--debug|-x] <comando>"
        echo ""
        echo "Modo mount (rclone) — monte numa pasta VAZIA; ela fica montada até o umount:"
        echo "  tnrx-connect                 -> Monta (se ainda não estiver montada) e abre o terminal SSH"
        echo "  tnrx-connect mount           -> Pergunta host/pasta remota e monta a pasta remota aqui (devolve o prompt)"
        echo "  tnrx-connect ssh             -> Abre o terminal SSH do servidor na pasta montada (sair não desmonta)"
        echo "  tnrx-connect umount [-f] [pasta] -> Snapshot final e desmonta (-f = desmontagem preguiçosa)"
        echo "  tnrx-connect status [pasta]  -> Estado da montagem, da conexão, do cache e dos snapshots"
        echo "  tnrx-connect refresh         -> Limpa o cache de diretórios (vê o que mudou no servidor agora)"
        echo "  tnrx-connect history [path]  -> Lista os snapshots (git sombra)"
        echo "  tnrx-connect restore <id> [path...] -> Restaura arquivos de um snapshot"
        echo "  tnrx-connect snapshot        -> Tira um snapshot agora"
        echo "  tnrx-connect jupyter         -> Acha os Jupyters do projeto que estão no ar, você escolhe e ele abre a ponte"
        echo "  tnrx-connect jupyter <URL|nó:porta> -> Abre a ponte pra um Jupyter cuja URL você já tem"
        echo "  tnrx-connect cluster [--host H] -> sinfo (GPUs livres por partição) e seus jobs, nos hosts montados"
        echo ""
        echo "Para ferramentas (VS Code), saída JSON, nunca pergunta nem autentica (docs/tnrx-connect-json.md):"
        echo "  tnrx-connect status --json"
        echo "  tnrx-connect cluster [--host H] --json  |  cluster cancel <job> --host H --json"
        echo "  tnrx-connect jupyter list --json  |  jupyter start|connect --host H --project P [--job J] --json"
        echo "  tnrx-connect jupyter stop <job> --host H --json"
        echo ""
        echo "Modo rsync (cópia local sincronizada, .tnrx_connect na pasta):"
        echo "  tnrx-connect rsync           -> Sincroniza em background e abre o SSH"
        echo "  tnrx-connect sync            -> Sincroniza uma vez (push local -> remoto)"
        echo "  tnrx-connect pull            -> Puxa do servidor pro local uma vez, sem --delete"
        echo "  tnrx-connect init            -> Cria o .tnrx_connect deste projeto"
        echo ""
        echo "Instalação:"
        echo "  tnrx-connect update          -> Atualiza o tnrx e o tnrx-connect a partir do GitHub"
        echo "  tnrx-connect update-dev [pasta] -> Instala a sua cópia de desenvolvimento (padrão: a pasta atual)"
        echo "                                (update e update-dev aceitam --choose: pergunta de novo o que instalar)"
        echo "  tnrx-connect version         -> Versão instalada"
        echo "  tnrx-connect uninstall       -> Remove os comandos e a pasta da instalação"
        ;;
esac
